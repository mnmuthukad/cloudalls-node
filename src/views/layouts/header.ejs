<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= pageTitle %></title>
  <meta name="description" content="<%= pageDescription %>">
  <meta name="keywords" content="<%= pageKeywords %>">
  <meta name="robots" content="<%= canonicalUrl.includes('z.cloudalls.com') ? 'noindex, nofollow, noarchive' : 'index, follow, max-image-preview:large' %>">
  <link rel="canonical" href="<%= canonicalUrl %>">
  <% if (settings.gsc_verification) { %><meta name="google-site-verification" content="<%= settings.gsc_verification %>"><% } %>
  <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">
  <link rel="icon" type="image/png" href="/assets/img/favicon.png">
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#071426">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="CloudAlls">
  <meta property="og:locale" content="en_IN">
  <meta property="og:url" content="<%= canonicalUrl %>">
  <meta property="og:title" content="<%= pageTitle %>">
  <meta property="og:description" content="<%= pageDescription %>">
  <meta property="og:image" content="<%= pageImage %>">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= pageTitle %>">
  <meta name="twitter:description" content="<%= pageDescription %>">
  <meta name="twitter:image" content="<%= pageImage %>">
  <link rel="preload" href="/assets/fonts/inter-v20-latin-regular.woff2" as="font" type="font/woff2" crossorigin="anonymous">
  <link rel="stylesheet" href="/assets/css/bootstrap.min.css">
  <link rel="stylesheet" href="/assets/css/style.css?v=direct-links-academy-20260816">
  <% if (recaptchaSiteKey) { %>
  <script src="https://www.google.com/recaptcha/api.js?render=<%= recaptchaSiteKey %>" nonce="<%= cspNonce %>" defer></script>
  <script nonce="<%= cspNonce %>">
    document.addEventListener('DOMContentLoaded', function () {
      document.querySelectorAll('form[data-recaptcha-action]').forEach(function (form) {
        form.addEventListener('submit', function (event) {
          if (form.dataset.recaptchaPending === 'true') return;
          event.preventDefault();
          form.dataset.recaptchaPending = 'true';
          if (!window.grecaptcha) {
            form.dataset.recaptchaPending = 'false';
            window.alert('Security verification is unavailable. Please refresh the page and try again.');
            return;
          }
          window.grecaptcha.ready(function () {
            window.grecaptcha.execute('<%= recaptchaSiteKey %>', { action: form.dataset.recaptchaAction || 'form' }).then(function (token) {
              var field = form.querySelector('input[name="recaptcha_token"]');
              if (field) field.value = token;
              HTMLFormElement.prototype.submit.call(form);
            }).catch(function () {
              form.dataset.recaptchaPending = 'false';
              window.alert('Security verification could not be completed. Please refresh the page and try again.');
            });
          });
        });
      });
    });
  </script>
  <% } %>
  <link rel="stylesheet" href="/assets/css/fontawesome.v7.min.css">
  <link rel="stylesheet" href="/assets/css/aos.css">
  <script type="application/ld+json" nonce="<%= cspNonce %>"><%- JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'CloudAlls',
    url: canonicalUrl,
    logo: `${canonicalUrl.split('/').slice(0, 3).join('/')}/assets/img/favicon.png`,
    description: pageDescription,
    address: { '@type': 'PostalAddress', addressLocality: 'Kerala', addressCountry: 'IN' },
    contactPoint: { '@type': 'ContactPoint', telephone: schemaPhone, contactType: 'customer service' },
    sameAs: socialLinks
  }) %></script>
</head>
<body>
<a class="skip-link" href="#main-content">Skip to main content</a>
<div class="site-utility-bar d-none d-lg-block" aria-label="Utility navigation">
  <div class="container d-flex align-items-center justify-content-between gap-3">
    <span>CloudAlls Ecosystem <span class="utility-separator">·</span> Strategy, engineering and intelligent systems</span>
    <div class="d-flex align-items-center gap-3"><a href="mailto:<%= settings.email || 'info@cloudalls.com' %>"><i class="fa-regular fa-envelope me-1" aria-hidden="true"></i><%= settings.email || 'info@cloudalls.com' %></a><span><i class="fa-solid fa-location-dot me-1" aria-hidden="true"></i><%= settings.company_address || 'Kerala, India' %></span></div>
  </div>
</div>
<nav class="navbar navbar-expand-lg fixed-top glass-nav" id="mainNav" aria-label="Primary navigation">
  <div class="container">
    <a class="navbar-brand d-flex align-items-center cloudalls-wordmark" href="/" aria-label="CloudAlls home"><%- settings.logo_code || '<span class="fw-bold text-dark">CloudAlls</span>' %></a>
    <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle primary navigation"><span class="navbar-toggler-icon" aria-hidden="true"></span></button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2 mt-3 mt-lg-0" aria-label="Primary links">
        <li class="nav-item"><a class="nav-link nav-link-enterprise <%= currentPage === 'index' ? 'active text-primary' : '' %>" href="/">Home</a></li>
        <li class="nav-item"><a class="nav-link nav-link-enterprise <%= currentPage === 'expertise' ? 'active text-primary' : '' %>" href="/expertise">Expertise</a></li>
        <li class="nav-item"><a class="nav-link nav-link-enterprise <%= currentPage === 'insights' ? 'active text-primary' : '' %>" href="/insights">Insights</a></li>
        <li class="nav-item"><a class="nav-link nav-link-enterprise <%= currentPage === 'about' ? 'active text-primary' : '' %>" href="/about">About</a></li>
        <li class="nav-item"><a class="nav-link nav-link-enterprise academy-link" href="https://academy.cloudalls.com/" target="_blank" rel="noopener noreferrer" aria-label="CloudAlls Academy (opens in new tab)">Academy <i class="fa-solid fa-arrow-up-right-from-square ms-1" aria-hidden="true"></i></a></li>
        <li class="nav-item ms-lg-2 mt-2 mt-lg-0"><a class="btn btn-primary btn-sm rounded-pill px-3 fw-bold nav-cta" href="/contact">Start a project <i class="fa-solid fa-arrow-up-right-from-square ms-1" aria-hidden="true"></i></a></li>
      </ul>
    </div>
  </div>
</nav>
<main id="main-content" tabindex="-1">
