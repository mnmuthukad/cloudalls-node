<footer class="footer-premium pt-0 mt-auto bg-white text-dark border-top border-secondary border-opacity-10 text-start w-100 position-relative z-1" aria-label="Site footer">
  <% const divisions = Array.isArray(settings.brand_divisions) ? settings.brand_divisions.filter(item => item && item.name).slice() : []; %>
  <% if (divisions.length) { %>
  <div class="sub-brand-marquee bg-white border-bottom border-secondary border-opacity-10" aria-label="CloudAlls divisions"><div class="sub-brand-track align-items-center"><% divisions.forEach((division) => { %><div class="sub-brand-item px-3"><div class="brand-pill d-flex align-items-center justify-content-center bg-white border border-secondary border-opacity-10 rounded-pill shadow-sm px-4 py-2"><span class="text-secondary fw-bold text-uppercase ls-1" style="font-size:0.7rem;"><%= division.name %></span></div></div><% }); %></div></div>
  <% } %>
  <div class="container py-5">
    <div class="row g-5 border-bottom border-secondary border-opacity-10 pb-5">
      <div class="col-xl-4 col-lg-5"><a href="/" class="text-decoration-none d-inline-block mb-3 cloudalls-wordmark" aria-label="CloudAlls home"><%- settings.logo_code || '<span class="fw-bold text-dark">CloudAlls</span>' %></a><p class="text-secondary mb-4" style="max-width:360px;">Organizing the new technology culture through strategy, engineering, intelligent systems, and responsible delivery.</p><div class="d-flex flex-wrap gap-2"><a class="btn btn-dark rounded-pill px-3" href="/contact">Start a project <i class="fa-solid fa-arrow-up-right-from-square ms-1" aria-hidden="true"></i></a><a class="btn btn-outline-dark rounded-pill px-3" href="/careers">Join the team</a></div></div>
      <div class="col-xl-8 col-lg-7"><div class="row g-4"><% Object.entries(footerMenus).forEach(([title, links]) => { %><div class="col-6 col-md-4"><h2 class="fw-bold mb-3 text-dark text-uppercase ls-1 h6 footer-heading"><%= title %></h2><ul class="list-unstyled d-flex flex-column gap-2 small fw-medium mb-0"><% Object.entries(links).forEach(([url, item]) => { const label = typeof item === 'string' ? item : item.label; const badge = typeof item === 'string' ? '' : (item.badge || ''); const isExternal = /^https?:\/\//.test(url); %><li><a href="<%= url %>" class="footer-link d-flex align-items-center gap-2" <%= isExternal ? 'target="_blank" rel="noopener noreferrer"' : '' %> aria-label="<%= label %><%= isExternal ? ' (opens in new tab)' : '' %>"><%= label %><% if (badge) { %><span class="beta-icon badge rounded-pill"><%= badge %></span><% } %><% if (isExternal) { %><i class="fa-solid fa-arrow-up-right-from-square ms-auto" aria-hidden="true"></i><% } %></a></li><% }); %></ul></div><% }); %></div></div>
    </div>
    <div class="row align-items-center gy-4 py-4 border-bottom border-secondary border-opacity-10 footer-contact-row"><div class="col-lg-7"><div class="d-flex flex-column flex-md-row align-items-start align-items-md-center gap-3 small text-muted fw-medium"><span class="d-flex align-items-center gap-2"><i class="fa-solid fa-location-dot text-primary" aria-hidden="true"></i><%= settings.company_address || 'Kerala, India' %></span><a href="tel:<%= settings.contact_number || '' %>" class="text-decoration-none text-muted hover-primary d-flex align-items-center gap-2"><i class="fa-solid fa-phone text-primary" aria-hidden="true"></i><%= settings.contact_number || '+91 904 820 8135' %></a><a href="mailto:<%= settings.email || 'info@cloudalls.com' %>" class="text-decoration-none text-muted hover-primary d-flex align-items-center gap-2"><i class="fa-solid fa-envelope text-primary" aria-hidden="true"></i><%= settings.email || 'info@cloudalls.com' %></a></div></div><div class="col-lg-5"><div class="d-flex gap-2 justify-content-lg-end flex-wrap"><% const socials = [['linkedin','LinkedIn','fa-linkedin-in'],['x_link','X','fa-x-twitter'],['youtube','YouTube','fa-youtube'],['instagram','Instagram','fa-instagram'],['github','GitHub','fa-github']]; socials.forEach(([key, label, icon]) => { if (settings[key]) { %><a href="<%= settings[key] %>" class="social-btn" target="_blank" rel="noopener noreferrer" aria-label="<%= label %>" title="<%= label %>"><i class="fa-brands <%= icon %>" aria-hidden="true"></i></a><% } }); %><a href="https://wa.me/<%= waLink %>?text=Hello%20CloudAlls!" class="social-btn" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" title="WhatsApp"><i class="fa-brands fa-whatsapp" aria-hidden="true"></i></a></div></div></div>
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-center gap-3 pt-4 small text-muted text-center text-lg-start"><div class="d-flex flex-wrap justify-content-center gap-3"><span>&copy; <%= new Date().getFullYear() %> CloudAlls Ecosystem</span><span>All Rights Reserved</span><a class="text-muted" href="/privacy">Privacy</a><a class="text-muted" href="/terms">Terms</a><a class="text-muted" href="/accessibility">Accessibility</a><a class="text-muted" href="/data-requests">Data requests</a></div><div class="d-flex align-items-center gap-2"><span>Engineered in India</span><img src="/assets/img/flags/in.svg" alt="India Flag" width="24" height="18" loading="lazy" decoding="async" class="rounded shadow-sm"></div></div>
  </div>
</footer>

<!-- Font Size Utility Widget -->
<div class="font-size-widget d-none d-md-flex" id="fontSizeWidget">
    <button class="font-size-btn" data-scale="sm" title="Small Text">A-</button>
    <button class="font-size-btn active" data-scale="md" title="Default Text">A</button>
    <button class="font-size-btn" data-scale="lg" title="Large Text">A+</button>
</div>

<button id="backToTop" class="back-to-top" type="button" aria-label="Back to top" title="Back to top"><i class="fa-solid fa-arrow-up" aria-hidden="true"></i></button>
<a href="https://wa.me/<%= waLink %>?text=Hello%20CloudAlls!" class="whatsapp-float" target="_blank" rel="noopener noreferrer" aria-label="Chat on WhatsApp" title="Chat on WhatsApp"><i class="fa-brands fa-whatsapp" aria-hidden="true"></i></a>
<div id="cookie-banner" class="position-fixed bottom-0 start-0 w-100 p-3" role="region" aria-label="Cookie preferences" aria-live="polite" style="z-index:1050;display:none;"><div class="container"><div class="cookie-banner-inner bg-dark text-white p-4 rounded-4 shadow-lg border border-secondary border-opacity-25 d-flex flex-column flex-md-row align-items-center justify-content-between gap-3"><div class="d-flex align-items-start gap-3"><i class="fa-solid fa-cookie-bite text-warning fs-2 mt-1" aria-hidden="true"></i><div><h2 class="h6 fw-bold mb-1">Privacy choices</h2><p class="small text-white-50 mb-0">We use essential cookies for secure sessions and form protection. See our <a href="/privacy" class="text-warning text-decoration-underline">Privacy &amp; Data Policy</a>.</p></div></div><div class="d-flex gap-2 shrink-0"><button id="btn-decline" type="button" class="btn btn-outline-light btn-sm rounded-pill px-4 fw-bold">Decline</button><button id="btn-accept" type="button" class="btn btn-primary btn-sm rounded-pill px-4 fw-bold">Accept</button></div></div></div></div>
<script src="/assets/js/bootstrap.bundle.min.js" defer></script>
<script src="/assets/js/aos.js" defer></script>
<script src="/assets/js/script.js" defer></script>
<script nonce="<%= cspNonce %>">
  document.addEventListener('DOMContentLoaded', function() {
    const body = document.body;
    const buttons = document.querySelectorAll('.font-size-btn');
    const savedScale = localStorage.getItem('mnc_font_scale') || 'md';
    
    function setScale(scale) {
      body.classList.remove('font-size-sm', 'font-size-md', 'font-size-lg');
      body.classList.add('font-size-' + scale);
      localStorage.setItem('mnc_font_scale', scale);
      buttons.forEach(btn => btn.classList.toggle('active', btn.dataset.scale === scale));
    }
    
    buttons.forEach(btn => {
      btn.addEventListener('click', () => setScale(btn.dataset.scale));
    });
    
    setScale(savedScale);
  });
</script>
<script nonce="<%= cspNonce %>">if ('serviceWorker' in navigator) window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js').catch(() => {}));</script>
</body>
</html>
