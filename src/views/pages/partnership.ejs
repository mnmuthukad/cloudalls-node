<%- include('../layouts/header', { pageTitle, pageDescription, pageKeywords, canonicalUrl, pageImage, settings, currentPage, socialLinks, schemaPhone, recaptchaSiteKey }) %>
<section class="container-fluid bg-dark text-white py-5">
  <div class="container py-5">
    <p class="text-uppercase fw-bold text-info small ls-1 mb-3">Alliances and ecosystem</p>
    <h1 class="display-3 fw-black ls-tight mb-4">Partner <span class="text-info">with purpose.</span></h1>
    <p class="lead text-white-50 mb-0" style="max-width: 780px;">CloudAlls works with cloud providers, academic institutions, technology vendors, agencies, and operators to create stronger digital ecosystems. Partners get structured access to the CloudAlls delivery network — engineering teams, platform APIs, and a client base spanning India, the GCC, and North America.</p>
  </div>
</section>

<section class="container py-5">
  <div class="row g-4">
    <div class="col-lg-4">
      <div class="h-100 p-4 p-lg-5 rounded-4 bg-white border shadow-sm">
        <i class="fa-brands fa-aws display-5 text-dark opacity-50 mb-4" aria-hidden="true"></i>
        <h2 class="h4 fw-bold">AWS Partner</h2>
        <p class="text-secondary mb-0">Enterprise-grade cloud hosting, scalable architectures, and serverless computing deployments.</p>
      </div>
    </div>
    <div class="col-lg-4">
      <div class="h-100 p-4 p-lg-5 rounded-4 bg-white border shadow-sm">
        <i class="fa-brands fa-google display-5 text-dark opacity-50 mb-4" aria-hidden="true"></i>
        <h2 class="h4 fw-bold">Google Cloud</h2>
        <p class="text-secondary mb-0">Advanced data analytics, machine learning model training, and robust global delivery networks.</p>
      </div>
    </div>
    <div class="col-lg-4">
      <div class="h-100 p-4 p-lg-5 rounded-4 bg-white border shadow-sm">
        <i class="fa-solid fa-building-columns display-5 text-dark opacity-50 mb-4" aria-hidden="true"></i>
        <h2 class="h4 fw-bold">Academic Network</h2>
        <p class="text-secondary mb-0">Strategic ties with technical institutes across Kerala to foster engineering talent and applied research.</p>
      </div>
    </div>
  </div>
</section>

<section class="container py-4">
  <div class="row g-4">
    <div class="col-md-4">
      <div class="p-4 rounded-4 bg-light border h-100">
        <p class="h3 fw-black text-primary mb-2">30+</p>
        <p class="small text-muted mb-0">Ecosystem partners and academic ties across India and the Gulf</p>
      </div>
    </div>
    <div class="col-md-4">
      <div class="p-4 rounded-4 bg-light border h-100">
        <p class="h3 fw-black text-primary mb-2">3 tiers</p>
        <p class="small text-muted mb-0">Commercial pathways matched to contribution level and integration depth</p>
      </div>
    </div>
    <div class="col-md-4">
      <div class="p-4 rounded-4 bg-light border h-100">
        <p class="h3 fw-black text-primary mb-2">5 days</p>
        <p class="small text-muted mb-0">Target response time for partnership applications and vendor reviews</p>
      </div>
    </div>
  </div>
</section>

<section class="bg-white py-5 border-top border-bottom">
  <div class="container py-4">
    <p class="text-uppercase fw-bold text-primary small ls-1 mb-2">Commercial pathways</p>
    <h2 class="display-6 fw-bold mb-3">Partnership tiers designed around contribution.</h2>
    <p class="text-secondary lead mb-5" style="max-width: 760px;">Choose the relationship model that matches your organization’s capabilities, integration needs, and shared outcomes.</p>
    <div class="table-responsive rounded-4 border shadow-sm">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th class="p-4">Tier</th>
            <th class="p-4">Best for</th>
            <th class="p-4">Benefits</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="p-4"><strong>Pro Partner</strong><span class="d-block small text-primary mt-1">Strategic tier</span></td>
            <td class="p-4 text-secondary">Deep API integration, joint customer success, and certified delivery capability.</td>
            <td class="p-4 text-secondary">Co-marketing, priority API access, dedicated account coordination, and enterprise support pathways.</td>
          </tr>
          <tr>
            <td class="p-4"><strong>Standard Partner</strong><span class="d-block small text-secondary mt-1">Integration tier</span></td>
            <td class="p-4 text-secondary">Verified technology vendors and service providers aligned with CloudAlls standards.</td>
            <td class="p-4 text-secondary">Ecosystem directory listing, referral agreements, and standard platform support.</td>
          </tr>
          <tr>
            <td class="p-4"><strong>Academic Partner</strong><span class="d-block small text-info mt-1">Educational tier</span></td>
            <td class="p-4 text-secondary">Accredited educational institutions and research laboratories.</td>
            <td class="p-4 text-secondary">Curriculum sharing, internship pipelines, and joint research initiatives.</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="container py-5">
  <div class="p-4 p-lg-5 rounded-4 bg-light border d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-4">
    <div>
      <h2 class="h4 fw-bold"><i class="fa-solid fa-shield-halved text-secondary me-2" aria-hidden="true"></i>Trust and compliance</h2>
      <p class="text-secondary mb-0" style="max-width: 760px;">A partnership designation represents commercial and technological alignment, not a legal joint venture. Trademark usage, independent contractor status, and program terms remain subject to the applicable legal documents.</p>
    </div>
    <a class="btn btn-outline-dark rounded-pill px-4 flex-shrink-0" href="/legal">View legal centre <i class="fa-solid fa-arrow-right ms-2" aria-hidden="true"></i></a>
  </div>
</section>

<section id="apply" class="bg-light py-5 border-top" style="scroll-margin-top: 80px;">
  <div class="container py-4">
    <div class="text-center mb-5">
      <p class="text-uppercase fw-bold text-primary small ls-1 mb-2">Start the conversation</p>
      <h2 class="display-6 fw-bold mb-3">Apply for partnership.</h2>
      <p class="text-secondary lead mx-auto mb-0" style="max-width: 650px;">Submit your corporate blueprint and our operations team will review the opportunity.</p>
    </div>
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <% if (status) { %>
          <div class="alert <%= status === 'success' ? 'alert-success' : 'alert-danger' %> border-0 rounded-4" role="status">
            <strong><%= status === 'success' ? 'Application received.' : 'Unable to process application.' %></strong>
            <%= status === 'success' ? " Our partnership team will contact you." : "" %><% if (status !== 'success' && errorMsg === 'invalid') { %> Please check the marked fields &mdash; company name, a full website URL (starting with https://), professional email, and the collaboration proposal are all required.<% } else if (status !== 'success' && errorMsg === 'verification') { %> Security verification did not pass &mdash; please disable ad-blockers, complete the page fully, and try again.<% } else if (status !== 'success') { %> Our database was momentarily unavailable &mdash; please retry in a moment.<% } %>
          </div>
        <% } %>
        <div class="p-4 p-md-5 bg-white border rounded-4 shadow-sm">
          <form action="/process-partnership" method="post" data-recaptcha-action="partnership" id="partnership-form">
            <input type="hidden" name="action_apply_partnership" value="1">
            <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
            <input type="hidden" name="recaptcha_token" value="">
            <input class="bot-trap" type="text" name="bot_trap" tabindex="-1" autocomplete="off" aria-hidden="true">
            <div class="row g-4">
              <div class="col-md-6"><label class="form-label small fw-bold text-muted text-uppercase" for="company-name">Company name</label><input class="form-control py-3" id="company-name"  name="company_name" maxlength="200" required<%= typeof formValues !== "undefined" && formValues.companyName ? String(formValues.companyName).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;') : "" %>></div>
              <div class="col-md-6"><label class="form-label small fw-bold text-muted text-uppercase" for="company-website">Corporate website</label><input class="form-control py-3" id="company-website"  name="website" type="url" placeholder="https://" maxlength="500" required<%= typeof formValues !== "undefined" && formValues.website ? String(formValues.website).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;') : "" %>></div>
              <div class="col-md-6"><label class="form-label small fw-bold text-muted text-uppercase" for="partner-email">Professional email</label><input class="form-control py-3" id="partner-email" name="email" type="email" maxlength="320" required<%= typeof formValues !== "undefined" && formValues.email ? String(formValues.email).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;') : "" %>></div>
              <div class="col-md-6"><label class="form-label small fw-bold text-muted text-uppercase" for="partner-tier">Partnership tier</label><select class="form-select py-3" id="partner-tier" name="partner_tier" required>
  <option value="Standard Partner" <%= typeof formValues !== "undefined" && formValues.partnerTier === "Standard Partner" ? "selected" : "" %>>Standard Partner (Integration)</option>
  <option value="Pro Partner" <%= typeof formValues !== "undefined" && formValues.partnerTier === "Pro Partner" ? "selected" : "" %>>Pro Partner (Strategic)</option>
  <option value="Academic Partner" <%= typeof formValues !== "undefined" && formValues.partnerTier === "Academic Partner" ? "selected" : "" %>>Academic Partner (Educational)</option>
</select></div>
              <div class="col-12"><label class="form-label small fw-bold text-muted text-uppercase" for="proposal">Collaboration proposal</label><textarea class="form-control py-3" id="proposal"  name="proposal" rows="6" maxlength="10000" placeholder="Describe the vision, capabilities, and mutual operational benefits..." required><%= typeof formValues !== "undefined" && formValues.proposal ? String(formValues.proposal).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;') : "" %></textarea></div>
              <div class="col-12"><button class="btn btn-dark btn-lg rounded-pill px-5 fw-bold" type="submit">Submit partnership proposal <i class="fa-solid fa-paper-plane ms-2" aria-hidden="true"></i></button></div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('../layouts/footer', { settings, footerMenus, waLink }) %>
