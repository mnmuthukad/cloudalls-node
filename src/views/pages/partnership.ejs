<%- include('../layouts/header', { pageTitle, pageDescription, pageKeywords, canonicalUrl, pageImage, settings, currentPage, socialLinks, schemaPhone }) %>
<section class="container-fluid bg-dark text-white py-5"><div class="container py-5"><p class="text-uppercase fw-bold text-info small ls-1 mb-3">Partner network</p><h1 class="display-3 fw-black ls-tight mb-4">Build stronger systems together.</h1><p class="lead text-white-50 mb-0" style="max-width:760px;">CloudAlls works with trusted organizations to create shared technology and operational value.</p></div></section>
<section class="container py-5"><div class="row g-5"><div class="col-lg-5"><h2 class="h3 fw-bold">A partnership with purpose.</h2><p class="text-secondary">Tell us about your organization, the opportunity, and how we can create a meaningful long-term relationship.</p><div class="d-flex flex-column gap-3 mt-4"><div class="p-4 rounded-4 bg-light border"><strong>Standard Partner</strong><p class="small text-secondary mb-0 mt-2">Focused collaboration for defined opportunities.</p></div><div class="p-4 rounded-4 bg-light border"><strong>Pro Partner</strong><p class="small text-secondary mb-0 mt-2">Deeper collaboration across delivery and growth.</p></div><div class="p-4 rounded-4 bg-light border"><strong>Strategic Partner</strong><p class="small text-secondary mb-0 mt-2">Long-term ecosystem and market collaboration.</p></div></div></div><div class="col-lg-7" id="apply"><% if (status) { %><div class="alert <%= status === 'success' ? 'alert-success' : 'alert-danger' %> border-0 rounded-4" role="status"><strong><%= status === 'success' ? 'Application received.' : 'Unable to process application.' %></strong> <%= status === 'success' ? 'Our partnership team will contact you.' : 'Please review your inputs and try again.' %></div><% } %><div class="p-4 p-md-5 bg-white border rounded-4 shadow-sm"><form action="/process-partnership" method="post"><input type="hidden" name="action_apply_partnership" value="1"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><div class="row g-4"><div class="col-md-6"><label class="form-label small fw-bold text-muted text-uppercase" for="company-name">Company name</label><input class="form-control py-3" id="company-name" name="company_name" maxlength="200" required></div><div class="col-md-6"><label class="form-label small fw-bold text-muted text-uppercase" for="company-website">Website</label><input class="form-control py-3" id="company-website" name="website" type="url" placeholder="https://" maxlength="500" required></div><div class="col-md-6"><label class="form-label small fw-bold text-muted text-uppercase" for="partner-email">Professional email</label><input class="form-control py-3" id="partner-email" name="email" type="email" maxlength="320" required></div><div class="col-md-6"><label class="form-label small fw-bold text-muted text-uppercase" for="partner-tier">Partner tier</label><select class="form-select py-3" id="partner-tier" name="partner_tier" required><option value="Standard Partner">Standard Partner</option><option value="Pro Partner">Pro Partner</option><option value="Strategic Partner">Strategic Partner</option></select></div><div class="col-12"><label class="form-label small fw-bold text-muted text-uppercase" for="proposal">Proposal</label><textarea class="form-control py-3" id="proposal" name="proposal" rows="6" maxlength="10000" required></textarea></div><div class="col-12"><button class="btn btn-dark btn-lg rounded-pill px-5 fw-bold" type="submit">Submit partnership proposal</button></div></div></form></div></div></div></section>
<%- include('../layouts/footer', { settings, footerMenus, waLink }) %>
