<%- include('../layouts/header', { pageTitle, pageDescription, pageKeywords, canonicalUrl, pageImage, settings, currentPage, socialLinks, schemaPhone }) %>
<article class="container py-5" style="max-width:1000px;"><a href="/portfolio" class="small text-primary text-decoration-none fw-bold">&larr; Back to case studies</a><p class="text-uppercase fw-bold text-info small ls-1 mt-5 mb-3">Case study</p><h1 class="display-4 fw-black ls-tight mb-3"><%= portfolio.title %></h1><p class="lead text-secondary"><%= portfolio.short_desc || '' %></p><% if (portfolio.client_name) { %><p class="small text-muted">Client: <%= portfolio.client_name %></p><% } %><hr class="my-5"><div class="text-secondary" style="line-height:1.85; white-space:pre-line;"><%= (portfolio.full_content || portfolio.short_desc || '').replace(/<[^>]*>/g, '') %></div><% if (portfolio.live_link) { %><a class="btn btn-primary rounded-pill mt-5" href="<%= portfolio.live_link %>" target="_blank" rel="noopener noreferrer">Visit live project</a><% } %></article>
<%- include('../layouts/footer', { settings, footerMenus, waLink }) %>
