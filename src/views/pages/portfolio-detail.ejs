<%- include('../layouts/header', { pageTitle, pageDescription, pageKeywords, canonicalUrl, pageImage, settings, currentPage, socialLinks, schemaPhone }) %>

<link rel="stylesheet" href="/assets/css/premium.css">

<script type="application/ld+json" nonce="<%= cspNonce %>">
<%- JSON.stringify({ 
    '@context': 'https://schema.org', 
    '@type': 'CreativeWork', 
    '@id': `${canonicalUrl}#case-study`, 
    name: portfolio.title, 
    description: portfolio.short_desc || pageDescription, 
    url: canonicalUrl, 
    image: pageImage, 
    creator: { '@type': 'Organization', name: 'CloudAlls' }, 
    publisher: { '@type': 'Organization', name: 'CloudAlls' }, 
    about: portfolio.client_name || undefined, 
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl } 
}) %>
</script>

<!-- Premium Hero -->
<section class="home-hero-mnc" style="min-height: 50vh; padding-top: 140px; padding-bottom: 60px;">
    <div class="hero-grid-premium" aria-hidden="true"></div>
    <div class="container position-relative">
        <div class="row">
            <div class="col-lg-10">
                <nav aria-label="breadcrumb" class="mb-4" data-aos="fade-up">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="/portfolio" class="text-info text-decoration-none small fw-bold text-uppercase ls-1">Case Studies</a></li>
                        <li class="breadcrumb-item active text-white-50 small text-uppercase ls-1" aria-current="page">Work Details</li>
                    </ol>
                </nav>
                <h1 class="hero-title-mnc mb-4" style="font-size: clamp(2rem, 5vw, 3.5rem);" data-aos="fade-up" data-aos-delay="100">
                    <%= portfolio.title %>
                </h1>
                <div class="d-flex align-items-center gap-3" data-aos="fade-up" data-aos-delay="200">
                    <div class="small text-white-50 text-uppercase ls-1" style="font-size: 0.7rem;">
                        <span class="text-info me-2">Client:</span> <%= portfolio.client_name || 'CloudAlls Ecosystem' %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Case Study Content -->
<section class="ecosystem-section py-5 bg-white">
    <div class="container py-lg-4">
        <div class="row justify-content-center">
            <div class="col-lg-9">
                <article class="editorial-content">
                    <% if (portfolio.image_url) { %>
                        <div class="mb-5 rounded-3 overflow-hidden shadow-sm" data-aos="fade-up">
                            <img src="<%= portfolio.image_url %>" alt="<%= portfolio.title %>" class="w-100 h-auto">
                        </div>
                    <% } %>
                    
                    <div class="lead fw-bold text-dark mb-5" style="font-size: 1.15rem; line-height: 1.6;" data-aos="fade-up">
                        <%= portfolio.short_desc || '' %>
                    </div>

                    <div class="text-secondary" style="font-size: 1.05rem; line-height: 1.8; white-space: pre-line;" data-aos="fade-up" data-aos-delay="100">
                        <%= (portfolio.full_content || portfolio.short_desc || '').replace(/<[^>]*>/g, '') %>
                    </div>

                    <% if (portfolio.live_link) { %>
                        <div class="mt-5 pt-4 border-top text-center" data-aos="fade-up">
                            <a class="btn btn-primary btn-lg rounded-pill px-5 py-3 fw-bold" style="font-size: 1rem;" href="<%= portfolio.live_link %>" target="_blank" rel="noopener noreferrer">
                                Visit Live Project <i class="fa-solid fa-arrow-up-right-from-square ms-2"></i>
                            </a>
                        </div>
                    <% } %>
                </article>
            </div>
        </div>
    </div>
</section>

<%- include('../layouts/footer', { settings, footerMenus, waLink }) %>
