<%- include('../layouts/header', { pageTitle, pageDescription, pageKeywords, canonicalUrl, pageImage, settings, currentPage, socialLinks, schemaPhone }) %>
<% const today = new Date().toISOString().slice(0, 10); const jobs = careers.filter(job => job.type !== 'Internship'); const internships = careers.filter(job => job.type === 'Internship'); %>

<link rel="stylesheet" href="/assets/css/premium.css">

<!-- Premium Hero -->
<section class="home-hero-mnc" style="min-height: 55vh; padding-top: 140px; padding-bottom: 60px;">
  <div class="hero-grid-premium" aria-hidden="true"></div>
  <div class="container position-relative">
    <div class="row">
      <div class="col-lg-8">
        <span class="hero-tagline" data-aos="fade-up">Careers & Academy</span>
        <h1 class="hero-title-mnc" data-aos="fade-up" data-aos-delay="100">
          Join the <span>mission.</span>
        </h1>
        <p class="hero-lead-mnc" data-aos="fade-up" data-aos-delay="200">
          Shape the future of the digital ecosystem through engineering, AI, and operational technology.
        </p>
        <div class="d-flex flex-wrap gap-3" data-aos="fade-up" data-aos-delay="300">
          <a class="btn btn-primary btn-lg rounded-pill px-5 py-3 fw-bold" style="font-size: 1rem;" href="#open-roles">View open roles</a>
          <a class="btn btn-outline-light btn-lg rounded-pill px-5 py-3 fw-bold" style="font-size: 1rem;" href="#internships">Student programs</a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Professional Roles -->
<section id="open-roles" class="ecosystem-section bg-white" style="scroll-margin-top: 80px;">
  <div class="container">
    <div class="row mb-5" data-aos="fade-up">
      <div class="col-lg-7">
        <span class="section-kicker">Professional Roles</span>
        <h2 class="h2 fw-bold text-dark">Build the systems that matter.</h2>
      </div>
      <div class="col-lg-5 text-lg-end d-flex align-items-end justify-content-lg-end mt-3 mt-lg-0">
        <span class="badge bg-dark rounded-pill px-3 py-2" style="font-size: 0.75rem;"><%= jobs.length %> POSITIONS LISTED</span>
      </div>
    </div>

    <div class="row g-4">
      <% if (jobs.length) { jobs.forEach((job, index) => { 
        const start = String(job.start_date || '').slice(0, 10); 
        const end = String(job.end_date || '').slice(0, 10); 
        const expired = end && today > end; 
        const upcoming = start && today < start; 
      %>
        <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="<%= index * 50 %>">
          <a href="/careers/<%= encodeURIComponent(String(job.id)) %>" class="ecosystem-card text-decoration-none h-100 <%= expired ? 'opacity-75' : '' %>">
            <div class="d-flex justify-content-between align-items-start mb-4">
              <span class="badge bg-primary-subtle text-primary-emphasis fw-bold rounded-pill px-3" style="font-size: 0.7rem;"><%= job.department %></span>
              <span class="badge <%= expired ? 'bg-danger-subtle text-danger' : upcoming ? 'bg-warning-subtle text-warning-emphasis' : 'bg-light text-muted' %> fw-bold rounded-pill px-3" style="font-size: 0.7rem;">
                <%= expired ? 'Closed' : upcoming ? `Opens ${start}` : job.type %>
              </span>
            </div>
            <h3 class="h5 fw-bold text-dark mb-2"><%= job.title %></h3>
            <p class="text-secondary small mb-3" style="font-size: 0.8rem;"><%= job.location_type %> · <%= job.location %></p>
            <p class="text-secondary small mb-4" style="line-height: 1.6;">
              <%= (job.description || '').replace(/<[^>]*>/g, '').replace(/\\r?\\n/g, ' ').slice(0, 160) %>...
            </p>
            <div class="mt-auto text-primary fw-bold small">
              <%= expired ? 'View archive' : 'View role' %> <i class="fa-solid fa-arrow-right ms-2"></i>
            </div>
          </a>
        </div>
      <% }); } else { %>
        <div class="col-12">
          <div class="p-5 rounded-4 bg-light border text-center">
            <p class="text-secondary mb-0">We are not currently listing active professional roles. Check back soon.</p>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</section>

<!-- Academy Programs -->
<section id="internships" class="ecosystem-section bg-light border-top" style="scroll-margin-top: 80px;">
  <div class="container">
    <div class="row mb-5" data-aos="fade-up">
      <div class="col-lg-7">
        <span class="section-kicker">CloudAlls Academy</span>
        <h2 class="h2 fw-bold text-dark">Learn through real delivery.</h2>
      </div>
      <div class="col-lg-5 text-lg-end d-flex align-items-end justify-content-lg-end mt-3 mt-lg-0">
        <span class="badge bg-success text-white rounded-pill px-3 py-2" style="font-size: 0.75rem;">STUDENT PROGRAMS</span>
      </div>
    </div>

    <div class="row g-4">
      <% if (internships.length) { internships.forEach((job, index) => { 
        const start = String(job.start_date || '').slice(0, 10); 
        const end = String(job.end_date || '').slice(0, 10); 
        const expired = end && today > end; 
        const upcoming = start && today < start; 
      %>
        <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="<%= index * 50 %>">
          <a href="/careers/<%= encodeURIComponent(String(job.id)) %>" class="ecosystem-card bg-white text-decoration-none h-100 <%= expired ? 'opacity-75' : '' %>">
            <div class="d-flex justify-content-between align-items-start mb-4">
              <span class="badge bg-info-subtle text-info-emphasis fw-bold rounded-pill px-3" style="font-size: 0.7rem;"><%= job.department %></span>
              <span class="badge <%= expired ? 'bg-danger-subtle text-danger' : upcoming ? 'bg-warning-subtle text-warning-emphasis' : 'bg-success-subtle text-success' %> fw-bold rounded-pill px-3" style="font-size: 0.7rem;">
                <%= expired ? 'Closed' : upcoming ? `Opens ${start}` : 'Internship' %>
              </span>
            </div>
            <h3 class="h5 fw-bold text-dark mb-2"><%= job.title %></h3>
            <p class="text-secondary small mb-3" style="font-size: 0.8rem;"><%= job.location_type %> · <%= job.location %></p>
            <p class="text-secondary small mb-4" style="line-height: 1.6;">
              <%= (job.description || '').replace(/<[^>]*>/g, '').replace(/\\r?\\n/g, ' ').slice(0, 160) %>...
            </p>
            <div class="mt-auto text-primary fw-bold small">
              <%= expired ? 'View archive' : 'Apply for program' %> <i class="fa-solid fa-arrow-right ms-2"></i>
            </div>
          </a>
        </div>
      <% }); } else { %>
        <div class="col-12">
          <div class="p-5 rounded-4 bg-white border text-center">
            <p class="text-secondary mb-0">Student programs are currently closed for this cycle.</p>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</section>

<%- include('../layouts/footer', { settings, footerMenus, waLink }) %>
