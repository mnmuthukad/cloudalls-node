<%- include('../layouts/header', { pageTitle, pageDescription, pageKeywords, canonicalUrl, pageImage, settings, currentPage, socialLinks, schemaPhone }) %>
<section class="container-fluid bg-dark text-white py-5"><div class="container py-5"><p class="text-uppercase fw-bold text-info small ls-1 mb-3">Careers and internship</p><h1 class="display-3 fw-black ls-tight mb-4">Build the next system with us.</h1><p class="lead text-white-50 mb-0" style="max-width:760px;">Join a multidisciplinary team working across AI, engineering, creative systems, and operations.</p></div></section>
<section class="container py-5"><div class="d-flex justify-content-between align-items-end mb-4"><div><h2 class="h3 fw-bold mb-2">Open roles</h2><p class="text-secondary mb-0">Current opportunities in the CloudAlls ecosystem.</p></div></div><div class="row g-4"><% if (careers.length) { careers.forEach(job => { %><article class="col-md-6"><div class="h-100 p-4 rounded-4 border bg-white shadow-sm"><div class="d-flex flex-wrap gap-2 mb-3"><span class="badge text-bg-primary"><%= job.type %></span><span class="badge text-bg-light"><%= job.location_type %></span></div><h3 class="h4 fw-bold"><%= job.title %></h3><p class="small text-muted mb-3"><%= job.department %> · <%= job.location %></p><p class="text-secondary"><%= (job.description || '').replace(/<[^>]*>/g, '').slice(0, 220) %></p><a class="btn btn-outline-primary rounded-pill" href="/careers_details?id=<%= job.id %>">View role</a></div></article><% }); } else { %><div class="col-12"><div class="p-5 rounded-4 bg-light border text-center"><h3 class="h4 fw-bold">No active roles are published right now.</h3><p class="text-secondary mb-0">Check back soon or use the contact page to introduce yourself.</p></div></div><% } %></div></section>
<%- include('../layouts/footer', { settings, footerMenus, waLink }) %>
