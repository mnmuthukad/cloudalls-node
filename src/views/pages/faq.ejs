<%- include('../layouts/header', { pageTitle, pageDescription, pageKeywords, canonicalUrl, pageImage, settings, currentPage, socialLinks, schemaPhone }) %>
<%
  var topicMap = {};
  faqs.forEach(function (faq) {
    var tid = (faq.id >= 1000 && faq.expertise_id) ? 'service' : 'general';
    topicMap[tid] = topicMap[tid] || [];
    topicMap[tid].push(faq);
  });
  var serviceFaqs = topicMap.service || [];
  var generalFaqs = topicMap.general || [];
  var hasCategories = serviceFaqs.length && generalFaqs.length;
%>

<link rel="stylesheet" href="/assets/css/premium.css">

<!-- Premium Hero -->
<section class="home-hero-mnc" style="min-height: 50vh; padding-top: 140px; padding-bottom: 60px;">
  <div class="hero-grid-premium" aria-hidden="true"></div>
  <div class="container position-relative">
    <div class="row">
      <div class="col-lg-8">
        <span class="hero-tagline" data-aos="fade-up">Help Centre</span>
        <h1 class="hero-title-mnc" data-aos="fade-up" data-aos-delay="100">
          Answers before <span>you ask.</span>
        </h1>
        <p class="hero-lead-mnc" data-aos="fade-up" data-aos-delay="200">
          Search our knowledge base by keyword or jump to a strategic topic below.
        </p>
      </div>
    </div>
  </div>
</section>

<section class="ecosystem-section bg-white" id="faq-section">
  <div class="container">
    <!-- Search -->
    <div class="row justify-content-center mb-5" data-aos="fade-up">
      <div class="col-lg-8">
        <div class="search-input-wrap position-relative">
          <i class="fa-solid fa-magnifying-glass position-absolute text-muted" style="top: 50%; left: 20px; transform: translateY(-50%);" aria-hidden="true"></i>
          <input type="search" id="faq-search" class="form-control form-control-lg ps-5 rounded-pill border-2" style="font-size: 1rem;" placeholder="Search questions — e.g. security, payment, timeline..." aria-label="Search FAQs">
        </div>
      </div>
    </div>

    <!-- Topic chips -->
    <div class="d-flex flex-wrap justify-content-center gap-2 mb-5" id="faq-topics" data-aos="fade-up">
      <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-4 py-2 fw-bold topic-btn active" data-topic="all" style="font-size: 0.8rem;">All Questions <span class="opacity-50 ms-1"><%= faqs.length %></span></button>
      <% if (hasCategories) { %>
      <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-4 py-2 fw-bold topic-btn" data-topic="service" style="font-size: 0.8rem;">Service-specific <span class="opacity-50 ms-1"><%= serviceFaqs.length %></span></button>
      <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-4 py-2 fw-bold topic-btn" data-topic="general" style="font-size: 0.8rem;">General & Company <span class="opacity-50 ms-1"><%= generalFaqs.length %></span></button>
      <% } %>
    </div>

    <div class="row justify-content-center">
      <div class="col-lg-9">
        <div class="accordion" id="faqAccordion" data-aos="fade-up">
        <% if (faqs.length) { faqs.forEach((faq, index) => { %>
          <div class="accordion-item mb-3 border rounded-4 overflow-hidden faq-row shadow-sm" data-topic="<%= (faq.id >= 1000 && faq.expertise_id) ? 'service' : 'general' %>" data-q="<%= String(faq.question + ' ' + faq.answer).toLowerCase() %>">
            <h2 class="accordion-header" id="faq-heading-<%= faq.id %>">
              <button class="accordion-button <%= index === 0 ? '' : 'collapsed' %> fw-bold py-3 px-4" type="button" data-bs-toggle="collapse" data-bs-target="#faq-collapse-<%= faq.id %>" aria-expanded="<%= index === 0 ? 'true' : 'false' %>" style="font-size: 0.95rem;"><%= faq.question %></button>
            </h2>
            <div id="faq-collapse-<%= faq.id %>" class="accordion-collapse collapse <%= index === 0 ? 'show' : '' %>" data-bs-parent="#faqAccordion">
              <div class="accordion-body text-secondary py-4 px-4" style="font-size: 0.95rem; line-height: 1.7;"><%= faq.answer %></div>
            </div>
          </div>
        <% }); } %>
        </div>

        <div class="text-center py-5" id="faq-no-results" style="display:none;">
          <div class="ecosystem-icon mx-auto mb-4" style="width: 60px; height: 60px; font-size: 1.5rem;"><i class="fa-solid fa-circle-question"></i></div>
          <h3 class="h5 fw-bold">No questions match your search.</h3>
          <p class="text-secondary mb-4">Try different keywords, or reach our team directly.</p>
          <a href="/contact" class="btn btn-primary rounded-pill px-5 py-3 fw-bold" style="font-size: 0.9rem;">Ask us directly</a>
        </div>
      </div>
    </div>
  </div>
</section>

<script nonce="<%= cspNonce %>">
(function () {
  'use strict';
  var search = document.getElementById('faq-search');
  var noResults = document.getElementById('faq-no-results');
  var rows = Array.prototype.slice.call(document.querySelectorAll('.faq-row'));
  var state = { topic: 'all', query: '' };

  var decoy = document.createElement('div');
  function decode(text) {
    decoy.innerHTML = String(text || '');
    return decoy.textContent || '';
  }

  function applyFilter() {
    var q = state.query.trim().toLowerCase();
    var visible = 0;
    rows.forEach(function (row) {
      var tOk = state.topic === 'all' || String(row.getAttribute('data-topic') || '') === state.topic;
      var qOk = !q || decode(row.getAttribute('data-q')).indexOf(q) > -1;
      var show = tOk && qOk;
      row.style.display = show ? '' : 'none';
      if (show) visible += 1;
    });
    if (noResults) noResults.style.display = (visible === 0 && q) ? '' : 'none';
    Array.prototype.slice.call(document.querySelectorAll('.topic-btn')).forEach(function (btn) {
      btn.classList.toggle('active', String(btn.getAttribute('data-topic') || '') === state.topic);
    });
  }

  document.querySelectorAll('.topic-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      state.topic = String(btn.getAttribute('data-topic') || 'all');
      applyFilter();
    });
  });

  var timer = null;
  search.addEventListener('input', function () {
    clearTimeout(timer);
    timer = setTimeout(function () {
      state.query = search.value;
      applyFilter();
    }, 120);
  });

  var params = new URLSearchParams(window.location.search);
  if (params.get('q')) { state.query = params.get('q'); search.value = params.get('q'); }
  if (params.get('topic')) state.topic = params.get('topic');
  applyFilter();
})();
</script>
<%- include('../layouts/footer', { settings, footerMenus, waLink }) %>
