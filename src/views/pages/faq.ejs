<%- include('../layouts/header', { pageTitle, pageDescription, pageKeywords, canonicalUrl, pageImage, settings, currentPage, socialLinks, schemaPhone }) %>
<%
  // Group curated FAQs by service division (expertise page style).
  // Service FAQs carry expertise_id; general FAQs have expertise_id null/0.
  var serviceByName = {};
  expertise.forEach(function (item) { serviceByName[String(item.id)] = item; });

  var generalFaqs = [];
  var faqsByExpertise = {};
  faqs.forEach(function (faq) {
    if (faq.id >= 1000 && faq.expertise_id) {
      faqsByExpertise[String(faq.expertise_id)] = faqsByExpertise[String(faq.expertise_id)] || [];
      faqsByExpertise[String(faq.expertise_id)].push(faq);
    } else {
      generalFaqs.push(faq);
    }
  });

  // Group services that have FAQs by division, ordered like the expertise page.
  var divGroups = [];
  var seenDiv = {};
  expertise.forEach(function (item) {
    var list = faqsByExpertise[String(item.id)];
    if (!list || !list.length) return;
    var div = String(item.division || 'Other').trim();
    var g = seenDiv[div];
    if (!g) { g = { division: div, items: [], order: item.display_order || 0 }; seenDiv[div] = g; divGroups.push(g); }
    g.items.push({ expertise: item, faqs: list });
    if ((item.display_order || 0) < g.order) g.order = item.display_order || 0;
  });
  divGroups.sort(function (a, b) { return a.order - b.order; });
%>
<section class="editorial-hero"><div class="container"><p class="editorial-kicker mb-3">Help centre</p><h1 class="mb-4">Answers before you ask.</h1><p class="lead mb-0">Questions grouped by service area, with a search for anything else. Browse by division below, or find your answer in seconds.</p></div></section>

<section class="editorial-section bg-white" id="faq-section">
  <div class="container py-lg-4">

    <!-- Search: the fastest way to find an answer -->
    <div class="row justify-content-center mb-4">
      <div class="col-lg-8">
        <div class="position-relative">
          <i class="fa-solid fa-magnifying-glass position-absolute text-muted search-icon-left" style="top: 50%; transform: translateY(-50%);" aria-hidden="true"></i>
          <input type="search" id="faq-search" class="form-control form-control-lg ps-5 rounded-pill" placeholder="Search questions — e.g. security, payment, timeline, support..." aria-label="Search FAQs">
        </div>
        <p class="text-muted small mt-2 mb-0 text-center" id="search-hint">Type to filter instantly, or browse the service areas below.</p>
      </div>
    </div>

    <div id="faq-list">
    <% divGroups.forEach(function (g, gi) { %>
      <div class="division-group mb-5" data-division="<%= String(g.division).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') %>">
        <div class="d-flex align-items-baseline gap-3 mb-3 pt-2 border-bottom">
          <h2 class="h4 fw-bold mb-0"><%= g.division %></h2>
          <span class="badge rounded-pill bg-primary-subtle text-primary-emphasis fw-medium"><%= g.items.reduce(function (n, it) { return n + it.faqs.length; }, 0) %> questions</span>
        </div>
        <div class="row g-3">
        <% g.items.forEach(function (it) { %>
          <div class="col-12 col-lg-6 catalogue-card faq-card" data-title="<%= String(it.expertise.title).toLowerCase() %>" data-service-faq="1">
            <div class="p-4 rounded-3 bg-white border h-100" style="border-color:#eef1f6;">
              <div class="d-flex align-items-start gap-3 mb-3">
                <span class="capability-icon mt-1"><i class="fa-solid <%= it.expertise.icon || 'fa-circle-question' %>" aria-hidden="true"></i></span>
                <div>
                  <p class="small text-primary fw-semibold mb-1">CloudAlls <%= it.expertise.division %></p>
                  <h3 class="h5 fw-bold mb-0">
                    <a class="text-decoration-none text-reset" href="/expertise/<%= encodeURIComponent(it.expertise.slug) %>"><%= it.expertise.title %></a>
                  </h3>
                </div>
              </div>
              <div class="accordion" id="faq-accordion-<%= it.expertise.id %>-<%= gi %>">
              <% it.faqs.forEach(function (faq, qi) { %>
                <div class="accordion-item mb-2 border rounded-2 overflow-hidden faq-row" data-q="<%= String(faq.question + ' ' + faq.answer).toLowerCase() %>">
                  <h4 class="accordion-header" id="faq-heading-<%= faq.id %>">
                    <button class="accordion-button <%= qi === 0 ? '' : 'collapsed' %> fw-semibold py-3" type="button" data-bs-toggle="collapse" data-bs-target="#faq-collapse-<%= faq.id %>" aria-expanded="<%= qi === 0 ? 'true' : 'false' %>" aria-controls="faq-collapse-<%= faq.id %>"><%= faq.question %></button>
                  </h4>
                  <div id="faq-collapse-<%= faq.id %>" class="accordion-collapse collapse <%= qi === 0 ? 'show' : '' %>" aria-labelledby="faq-heading-<%= faq.id %>" data-bs-parent="#faq-accordion-<%= it.expertise.id %>-<%= gi %>">
                    <div class="accordion-body text-secondary small"><%= faq.answer %></div>
                  </div>
                </div>
              <% }); %>
              </div>
            </div>
          </div>
        <% }); %>
        </div>
      </div>
    <% }); %>

    <% if (generalFaqs.length) { %>
      <div class="division-group mb-5" data-division="general-company">
        <div class="d-flex align-items-baseline gap-3 mb-3 pt-2 border-bottom">
          <h2 class="h4 fw-bold mb-0">General &amp; company</h2>
          <span class="badge rounded-pill bg-primary-subtle text-primary-emphasis fw-medium"><%= generalFaqs.length %> questions</span>
        </div>
        <div class="row g-3">
          <div class="col-12 catalogue-card faq-card faq-card" data-title="general company questions" data-service-faq="0">
            <div class="p-4 rounded-3 bg-white border" style="border-color:#eef1f6;">
              <div class="accordion" id="faq-accordion-general">
              <% generalFaqs.forEach(function (faq, qi) { %>
                <div class="accordion-item mb-2 border rounded-2 overflow-hidden faq-row" data-q="<%= String(faq.question + ' ' + faq.answer).toLowerCase() %>">
                  <h4 class="accordion-header" id="faq-heading-<%= faq.id %>">
                    <button class="accordion-button <%= qi === 0 ? '' : 'collapsed' %> fw-semibold py-3" type="button" data-bs-toggle="collapse" data-bs-target="#faq-collapse-<%= faq.id %>" aria-expanded="<%= qi === 0 ? 'true' : 'false' %>" aria-controls="faq-collapse-<%= faq.id %>"><%= faq.question %></button>
                  </h4>
                  <div id="faq-collapse-<%= faq.id %>" class="accordion-collapse collapse <%= qi === 0 ? 'show' : '' %>" aria-labelledby="faq-heading-<%= faq.id %>" data-bs-parent="#faq-accordion-general">
                    <div class="accordion-body text-secondary small"><%= faq.answer %></div>
                  </div>
                </div>
              <% }); %>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% } %>
    </div>

    <div class="text-center py-5" id="no-results" style="display:none;">
      <i class="fa-solid fa-magnifying-glass fa-3x text-muted mb-3" aria-hidden="true"></i>
      <h3 class="h5 fw-bold">Nothing matches "<span id="no-results-term"></span>"</h3>
      <p class="text-secondary mb-3">Try a simpler word, or browse a different service area above.</p>
      <a href="/contact" class="btn btn-primary rounded-pill px-4">Ask us directly instead</a>
    </div>
  </div>
</section>

<script nonce="<%= cspNonce %>">
(function () {
  'use strict';
  var search = document.getElementById('faq-search');
  var hint = document.getElementById('search-hint');
  var noResults = document.getElementById('no-results');
  var noTerm = document.getElementById('no-results-term');
  var groups = Array.prototype.slice.call(document.querySelectorAll('.division-group'));
  var state = { query: '' };

  // Decode HTML entities (e.g. &amp;) in data attributes so search matches plain text.
  var decoy = document.createElement('div');
  function decode(text) {
    decoy.innerHTML = String(text || '');
    return decoy.textContent || '';
  }

  function applyFilter() {
    var q = state.query.trim().toLowerCase();
    var totalVisible = 0;
    groups.forEach(function (group) {
      var cards = Array.prototype.slice.call(group.querySelectorAll('.faq-card'));
      var groupVisible = 0;
      cards.forEach(function (card) {
        var isServiceCard = card.getAttribute('data-service-faq') === '1';
        var qOk = !q || decode(card.getAttribute('data-title')).indexOf(q) > -1 || (isServiceCard ? decode(card.querySelector('.accordion-item').getAttribute('data-q')).indexOf(q) > -1 : true);
        card.style.display = qOk ? '' : 'none';
        if (qOk) {
          groupVisible += 1;
          totalVisible += Array.prototype.slice.call(card.querySelectorAll('.faq-row')).filter(function (row) {
            return !q || decode(row.getAttribute('data-q')).indexOf(q) > -1;
          }).length;
          // Filter rows inside the card when searching.
          card.querySelectorAll('.faq-row').forEach(function (row) {
            row.style.display = (!q || decode(row.getAttribute('data-q')).indexOf(q) > -1) ? '' : 'none';
          });
        } else {
          card.querySelectorAll('.faq-row').forEach(function (row) { row.style.display = 'none'; });
        }
      });
      group.style.display = groupVisible > 0 ? '' : 'none';
    });
    if (noResults) {
      noResults.style.display = (totalVisible === 0 && q) ? '' : 'none';
      noTerm.textContent = state.query;
    }
    if (hint) hint.style.display = q ? 'none' : '';
  }

  var timer = null;
  search.addEventListener('input', function () {
    clearTimeout(timer);
    timer = setTimeout(function () {
      state.query = search.value;
      applyFilter();
      if (state.query && history.replaceState) {
        history.replaceState(null, '', '/faq?q=' + encodeURIComponent(state.query) + '#faq-section');
      } else if (!state.query && history.replaceState) {
        history.replaceState(null, '', '/faq#faq-section');
      }
    }, 120);
  });

  var params = new URLSearchParams(window.location.search);
  var initQ = params.get('q');
  if (initQ) { state.query = initQ; search.value = initQ; }
  applyFilter();
})();
</script>
<%- include('../layouts/footer', { settings, footerMenus, waLink }) %>
