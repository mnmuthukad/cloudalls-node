<%- include('../layouts/header', { pageTitle, pageDescription, pageKeywords, canonicalUrl, pageImage, settings, currentPage, socialLinks, schemaPhone }) %>
<section class="container-fluid text-white py-5" style="background:linear-gradient(135deg,#0f172a,#1e293b);"><div class="container py-5"><p class="text-uppercase fw-bold text-info small ls-1 mb-3">Legal center</p><h1 class="display-4 fw-black ls-tight mb-3"><%= document.title %></h1><p class="lead opacity-75 mb-0">Version <%= document.version %> · Effective <%= new Date(document.effective_date).toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' }) %></p></div></section>
<section class="py-5" style="background:#fafafa;"><div class="container py-4"><div class="row justify-content-center"><div class="col-xl-9"><article class="bg-white border rounded-4 p-4 p-md-5 shadow-sm legal-document-content"><%- document.content %></article><div class="mt-4 p-4 rounded-4 bg-light border d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3"><div><h2 class="h5 fw-bold mb-1">Need to exercise a data right?</h2><p class="text-secondary mb-0">Use the secure CloudAlls data-request workflow.</p></div><a class="btn btn-primary rounded-pill px-4" href="/data-requests">Open DSR form</a></div></div></div></div></section>
<%- include('../layouts/footer', { settings, footerMenus, waLink }) %>
