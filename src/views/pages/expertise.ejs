<%- include('../layouts/header', { pageTitle, pageDescription, pageKeywords, canonicalUrl, pageImage, settings, currentPage, socialLinks, schemaPhone }) %>
<% const slugify = (name) => String(name || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, ''); %>

<section class="editorial-hero"><div class="container"><p class="editorial-kicker mb-3">Our capabilities</p><h1 class="mb-4">Find exactly what you need.</h1><p class="lead mb-0">Fifty-one services across twelve divisions. Start by typing what you need, or browse by division below.</p></div></section>

<section class="editorial-section bg-white" id="capabilities">
  <div class="container py-lg-4">

    <!-- Search: the fastest way to find a service -->
    <div class="row justify-content-center mb-4">
      <div class="col-lg-8">
        <div class="position-relative">
          <i class="fa-solid fa-magnifying-glass position-absolute text-muted search-icon-left" style="top: 50%; transform: translateY(-50%);" aria-hidden="true"></i>
          <input type="search" id="service-search" class="form-control form-control-lg ps-5 rounded-pill" placeholder="Search a service — e.g. e-commerce, chatbots, DevOps, security..." aria-label="Search services">
        </div>
        <p class="text-muted small mt-2 mb-0 text-center" id="search-hint">Type to filter instantly, or scroll to the divisions below.</p>
      </div>
    </div>

    <div id="catalogue-list">
    <% const grouped = {}; expertise.forEach(item => { const div = String(item.division || '').trim(); (grouped[div] = grouped[div] || []).push(item); });
       const divOrder = Object.keys(grouped).sort((a, b) => (grouped[a][0].display_order ?? 0) - (grouped[b][0].display_order ?? 0)); %>
    <% divOrder.forEach(div => { %>
      <div class="division-group mb-5" data-division="<%= slugify(div) %>">
        <div class="d-flex align-items-baseline gap-3 mb-3 pt-2 border-bottom">
          <h2 class="h4 fw-bold mb-0"><%= div %></h2>
          <span class="badge rounded-pill bg-primary-subtle text-primary-emphasis fw-medium"><%= grouped[div].length %> services</span>
        </div>
        <div class="row g-3">
        <% grouped[div].forEach(item => { %>
          <div class="col-12 col-sm-6 col-lg-4 catalogue-card" data-division="<%= slugify(div) %>" data-wing="<%= String(item.wing || '').trim() %>" data-title="<%= String(item.title).toLowerCase() %>" data-desc="<%= String(item.short_description || '').toLowerCase() %>">
            <a class="d-block p-4 rounded-3 bg-white border h-100 text-decoration-none transition-hover" href="/expertise/<%= encodeURIComponent(item.slug) %>" style="border-color:#eef1f6;">
              <div class="d-flex align-items-start gap-3 mb-3">
                <span class="capability-icon mt-1"><i class="fa-solid <%= item.icon || 'fa-code' %>" aria-hidden="true"></i></span>
                <div>
                  <p class="small text-primary fw-semibold mb-1">CloudAlls <%= div %></p>
                  <h3 class="h5 fw-bold mb-0"><%= item.title %></h3>
                </div>
              </div>
              <p class="text-secondary mb-0 small"><%= String(item.short_description || '').slice(0, 130) %></p>
            </a>
          </div>
        <% }); %>
        </div>
      </div>
    <% }); %>
    </div>

    <div class="text-center py-5" id="no-results" style="display:none;">
      <i class="fa-solid fa-magnifying-glass fa-3x text-muted mb-3" aria-hidden="true"></i>
      <h3 class="h5 fw-bold">Nothing matches "<span id="no-results-term"></span>"</h3>
      <p class="text-secondary mb-3">Try a simpler word, or browse a different division above.</p>
      <a href="/contact" class="btn btn-primary rounded-pill px-4">Tell us what you need instead</a>
    </div>
  </div>
</section>

<script nonce="<%= cspNonce %>">
(function () {
  'use strict';
  var search = document.getElementById('service-search');
  var hint = document.getElementById('search-hint');
  var noResults = document.getElementById('no-results');
  var noTerm = document.getElementById('no-results-term');
  var groups = Array.prototype.slice.call(document.querySelectorAll('.division-group'));
  var allCards = Array.prototype.slice.call(document.querySelectorAll('.catalogue-card'));
  var state = { query: '' };

  // Decode HTML entities (e.g. &amp;) in data attributes so search matches plain text.
  var decoy = document.createElement('div');
  function decode(text) {
    decoy.innerHTML = String(text || '');
    return decoy.textContent || '';
  }

  function applyFilter() {
    var q = state.query.trim().toLowerCase();
    var anyVisible = false;
    var totalVisible = 0;
    groups.forEach(function (group) {
      var cards = Array.prototype.slice.call(group.querySelectorAll('.catalogue-card'));
      var groupVisible = 0;
      cards.forEach(function (card) {
        var qOk = !q || decode(card.getAttribute('data-title')).indexOf(q) > -1 || decode(card.getAttribute('data-desc')).indexOf(q) > -1;
        var show = qOk;
        card.style.display = show ? '' : 'none';
        if (show) { groupVisible += 1; totalVisible += 1; }
      });
      group.style.display = groupVisible > 0 ? '' : 'none';
      if (groupVisible > 0) anyVisible = true;
    });
    if (noResults) {
      noResults.style.display = (totalVisible === 0 && q) ? '' : 'none';
      noTerm.textContent = state.query;
    }
    if (hint) hint.style.display = q ? 'none' : '';
  }

  var timer = null;
  search.addEventListener('input', function () {
    clearTimeout(timer);
    timer = setTimeout(function () {
      state.query = search.value;
      applyFilter();
      if (state.query && history.replaceState) {
        history.replaceState(null, '', '/expertise?q=' + encodeURIComponent(state.query) + '#capabilities');
      } else if (!state.query && history.replaceState) {
        history.replaceState(null, '', '/expertise#capabilities');
      }
    }, 120);
  });

  var params = new URLSearchParams(window.location.search);
  var initQ = params.get('q');
  if (initQ) { state.query = initQ; search.value = initQ; }
  applyFilter();
})();
</script>
<%- include('../layouts/footer', { settings, footerMenus, waLink }) %>
