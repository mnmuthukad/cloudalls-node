<%- include('../layouts/header', { pageTitle, pageDescription, pageKeywords, canonicalUrl, pageImage, settings, currentPage, socialLinks, schemaPhone }) %>
<% const splitValues = (value) => String(value || '').split(',').map(item => item.trim()).filter(Boolean); %>
<section class="editorial-hero"><div class="container"><p class="editorial-kicker mb-3">Capabilities</p><h1 class="mb-4">Technology that makes the complex usable.</h1><p class="lead mb-0">Explore the CloudAlls ecosystem — fifteen services organized under four subsidiaries: Foundry, Intelligence, Studio, and Academy &amp; Operations. Start with the capability that matches the decision in front of you.</p></div></section>
<section class="editorial-section bg-white"><div class="container"><div class="row align-items-end g-4 mb-5"><div class="col-lg-8"><p class="section-kicker mb-3">Capability catalogue</p><h2 class="display-6 fw-bold mb-3">Specialists around the problem.</h2><p class="text-secondary lead mb-0">Every engagement is shaped around outcomes, constraints, and the operating environment—not a fixed package.</p></div><div class="col-lg-4 text-lg-end"><a class="btn btn-primary rounded-pill px-4" href="/contact">Discuss your requirement <i class="fa-solid fa-arrow-right ms-2" aria-hidden="true"></i></a></div></div><div class="row g-4"><% if (expertise.length) { expertise.forEach((item, index) => { const benefits = splitValues(item.key_benefits); const services = splitValues(item.sub_services); %><div class="col-12"><article class="capability-detail-card"><div class="row g-4 align-items-start"><div class="col-lg-4"><div class="d-flex align-items-start gap-3"><span class="capability-icon mt-1"><i class="fa-solid <%= item.icon || 'fa-code' %>" aria-hidden="true"></i></span><div><span class="small text-primary fw-bold"><%= String(index + 1).padStart(2, '0') %></span><h2 class="h3 fw-bold mb-2"><%= item.title %></h2><p class="text-secondary mb-0"><%= item.short_description || '' %></p><% if (item.division) { %><span class="badge rounded-pill bg-light border text-primary mt-2 px-3"><i class="fa-solid fa-building me-1" aria-hidden="true"></i>CloudAlls <%= item.division %></span><% } %></div></div></div><div class="col-lg-5"><% if (item.full_description) { %><p class="text-secondary lh-lg mb-3"><%= item.full_description %></p><% } %><% if (services.length) { %><div class="d-flex flex-wrap gap-2"><% services.slice(0, 5).forEach(service => { %><span class="badge rounded-pill text-bg-light border px-3 py-2"><%= service %></span><% }); %></div><% } %></div><div class="col-lg-3"><div class="capability-meta"><% if (item.delivery_time) { %><span><small>Typical delivery</small><strong><%= item.delivery_time %></strong></span><% } %><% if (item.price_range) { %><span><small>Engagement</small><strong><%= item.price_range %></strong></span><% } %><a class="btn btn-dark rounded-pill w-100 mt-2" href="/expertise/<%= encodeURIComponent(item.slug) %>">View capability <i class="fa-solid fa-arrow-up-right-from-square ms-1" aria-hidden="true"></i></a></div></div></div><% if (benefits.length) { %><div class="border-top mt-4 pt-3"><div class="d-flex flex-wrap gap-3 small text-secondary"><% benefits.slice(0, 6).forEach(benefit => { %><span><i class="fa-solid fa-check text-primary me-2" aria-hidden="true"></i><%= benefit %></span><% }); %></div></div><% } %></article></div><% }); } else { %><div class="col-12"><div class="enterprise-card text-center"><h3 class="h4 fw-bold">Capability catalogue is being refreshed.</h3><p class="text-secondary mb-0">Start a conversation and our team will route your requirement to the right specialists.</p></div></div><% } %></div></div></section>
<section class="editorial-section bg-light"><div class="container"><div class="row g-4"><div class="col-lg-4"><p class="section-kicker mb-3">How it connects</p><h2 class="h1 fw-bold">One operating model.</h2><p class="text-secondary">Capabilities are stronger when the handoffs are designed in from the start.</p></div><div class="col-lg-8"><div class="row g-3"><div class="col-md-4"><div class="enterprise-card"><span class="home-proof-index">01</span><h3 class="h5 fw-bold mt-3">Direction</h3><p class="mb-0">We define the decision and the evidence needed to make it.</p></div></div><div class="col-md-4"><div class="enterprise-card"><span class="home-proof-index">02</span><h3 class="h5 fw-bold mt-3">Delivery</h3><p class="mb-0">We build an accessible, secure, and observable path to value.</p></div></div><div class="col-md-4"><div class="enterprise-card"><span class="home-proof-index">03</span><h3 class="h5 fw-bold mt-3">Continuity</h3><p class="mb-0">We document the system so teams can operate and improve it.</p></div></div></div></div></div></div></section>
<%- include('../layouts/footer', { settings, footerMenus, waLink }) %>
