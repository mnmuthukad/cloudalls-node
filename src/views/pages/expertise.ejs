<%- include('../layouts/header', { pageTitle, pageDescription, pageKeywords, canonicalUrl, pageImage, settings, currentPage, socialLinks, schemaPhone }) %>
<% const slugify = (name) => String(name || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, ''); %>
<section class="editorial-hero"><div class="container"><p class="editorial-kicker mb-3">Capabilities</p><h1 class="mb-4">Technology that makes the complex usable.</h1><p class="lead mb-0">Fifty-one capabilities across the CloudAlls ecosystem. Filter by division or wing — detail for each one lives on its own page.</p></div></section>

<section class="editorial-section bg-white" id="capabilities">
  <div class="container py-lg-5">
    <div class="row g-3 mb-4">
      <div class="col-12">
        <div class="d-flex flex-wrap gap-2" id="filter-bar">
          <button type="button" class="btn btn-light rounded-pill px-3 py-2 fw-medium filter-btn active" data-filter="all">All <span class="opacity-50"><%= expertise.length %></span></button>
          <% const counts = {}; expertise.forEach(item => { const key = String(item.division || '').trim(); counts[key] = (counts[key] || 0) + 1; });
             Object.keys(counts).forEach(div => { %>
          <button type="button" class="btn btn-light rounded-pill px-3 py-2 fw-medium filter-btn" data-filter="<%= slugify(div) %>"><%= div %> <span class="opacity-50"><%= counts[div] %></span></button>
          <% }); %>
        </div>
      </div>
      <div class="col-12">
        <div class="d-flex gap-2" id="wing-tabs">
          <button type="button" class="btn btn-sm rounded-pill px-3 py-1 border-0 fw-medium wing-btn active" data-wing="all">Everything</button>
          <button type="button" class="btn btn-sm rounded-pill px-3 py-1 border-0 fw-medium wing-btn" data-wing="A">Wing A</button>
          <button type="button" class="btn btn-sm rounded-pill px-3 py-1 border-0 fw-medium wing-btn" data-wing="B">Wing B</button>
        </div>
      </div>
    </div>

    <div class="row g-4 py-3" id="catalogue-grid">
    <% if (expertise.length) { expertise.forEach(item => { %>
      <div class="col-lg-4 catalogue-card" data-division="<%= slugify(item.division) %>" data-wing="<%= String(item.wing || '').toUpperCase() === 'B' ? 'B' : 'A' %>">
        <a class="d-block p-4 rounded-3 bg-white border h-100 text-decoration-none transition-hover" href="/expertise/<%= encodeURIComponent(item.slug) %>" style="border-color:#eef1f6;">
          <div class="d-flex align-items-start gap-3 mb-3">
            <span class="capability-icon mt-1"><i class="fa-solid <%= item.icon || 'fa-code' %>" aria-hidden="true"></i></span>
            <div>
              <p class="small text-primary fw-semibold mb-1">CloudAlls <%= item.division %></p>
              <h3 class="h5 fw-bold mb-0"><%= item.title %></h3>
            </div>
          </div>
          <p class="text-secondary mb-0 small"><%= String(item.short_description || '').slice(0, 130) %></p>
        </a>
      </div>
    <% }); } else { %>
      <div class="col-12"><div class="enterprise-card text-center"><h3 class="h4 fw-bold">Capability catalogue is being refreshed.</h3><p class="text-secondary mb-0">Start a conversation and our team will route your requirement to the right specialists.</p></div></div>
    <% } %>
    </div>
    <div class="text-center py-4" id="no-results" style="display:none;">
      <p class="text-secondary small"><i class="fa-solid fa-filter-circle-xmark me-2" aria-hidden="true"></i>No capabilities match this filter.</p>
    </div>
  </div>
</section>

<script>
(function () {
  'use strict';
  var grid = document.getElementById('catalogue-grid');
  var noResults = document.getElementById('no-results');
  var cards = grid ? Array.prototype.slice.call(grid.querySelectorAll('.catalogue-card')) : [];
  var state = { div: 'all', wing: 'all' };

  function applyFilter() {
    var visible = 0;
    cards.forEach(function (card) {
      var divOk = state.div === 'all' || String(card.getAttribute('data-division') || '') === state.div;
      var wingOk = state.wing === 'all' || String(card.getAttribute('data-wing') || '') === state.wing;
      var show = divOk && wingOk;
      card.style.display = show ? '' : 'none';
      if (show) visible += 1;
    });
    if (noResults) noResults.style.display = visible === 0 ? '' : 'none';
    Array.prototype.slice.call(document.querySelectorAll('.filter-btn')).forEach(function (btn) {
      btn.classList.toggle('active', String(btn.getAttribute('data-filter') || '') === state.div);
    });
    Array.prototype.slice.call(document.querySelectorAll('.wing-btn')).forEach(function (btn) {
      btn.classList.toggle('active', String(btn.getAttribute('data-wing') || '') === state.wing);
    });
  }

  Array.prototype.slice.call(document.querySelectorAll('.filter-btn')).forEach(function (btn) {
    btn.addEventListener('click', function () {
      state.div = String(btn.getAttribute('data-filter') || 'all');
      applyFilter();
      if (history.replaceState) history.replaceState(null, '', '/expertise' + (state.div === 'all' ? '' : '?div=' + state.div + '&wing=' + state.wing) + '#capabilities');
    });
  });
  Array.prototype.slice.call(document.querySelectorAll('.wing-btn')).forEach(function (btn) {
    btn.addEventListener('click', function () {
      state.wing = String(btn.getAttribute('data-wing') || 'all');
      applyFilter();
      if (history.replaceState) history.replaceState(null, '', '/expertise' + (state.div === 'all' && state.wing === 'all' ? '' : '?' + (state.div !== 'all' ? 'div=' + state.div : '') + (state.div !== 'all' && state.wing !== 'all' ? '&' : '') + (state.wing !== 'all' ? 'wing=' + state.wing : '')) + '#capabilities');
    });
  });

  var params = new URLSearchParams(window.location.search);
  var initDiv = params.get('div');
  var initWing = params.get('wing');
  if (initDiv) state.div = initDiv === 'all' ? 'all' : initDiv.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
  if (initWing && (initWing === 'A' || initWing === 'B')) state.wing = initWing;
  applyFilter();
})();
</script>
<%- include('../layouts/footer', { settings, footerMenus, waLink }) %>
