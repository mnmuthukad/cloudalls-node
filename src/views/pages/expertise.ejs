<%- include('../layouts/header', { pageTitle, pageDescription, pageKeywords, canonicalUrl, pageImage, settings, currentPage, socialLinks, schemaPhone }) %>
<% const slugify = (name) => String(name || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, ''); %>

<link rel="stylesheet" href="/assets/css/premium.css">

<!-- Premium Hero -->
<section class="home-hero-mnc" style="min-height: 60vh; padding-top: 160px; padding-bottom: 60px;">
  <div class="hero-grid-premium" aria-hidden="true"></div>
  <div class="container position-relative">
    <div class="row">
      <div class="col-lg-8">
        <span class="hero-tagline" data-aos="fade-up">Global Capabilities</span>
        <h1 class="hero-title-mnc" data-aos="fade-up" data-aos-delay="100">
          Built to <span>deliver certainty.</span>
        </h1>
        <p class="hero-lead-mnc" data-aos="fade-up" data-aos-delay="200">
          Fifty-one specialized services organized into twelve divisions, unified under one standard of engineering excellence.
        </p>
      </div>
    </div>
  </div>
</section>

<section class="editorial-section bg-white" id="capabilities">
  <div class="container py-lg-5">
    
    <!-- Strategic Pillar Navigation -->
    <div class="row mb-5" data-aos="fade-up">
      <div class="col-12">
        <div class="d-flex flex-wrap gap-2 justify-content-center">
          <button class="btn btn-outline-primary rounded-pill px-4 py-2 fw-bold filter-pillar-btn active" data-pillar="all">All Capabilities</button>
          <button class="btn btn-outline-primary rounded-pill px-4 py-2 fw-bold filter-pillar-btn" data-pillar="engineering">Engineering & Labs</button>
          <button class="btn btn-outline-primary rounded-pill px-4 py-2 fw-bold filter-pillar-btn" data-pillar="intelligence">Intelligence & Growth</button>
          <button class="btn btn-outline-primary rounded-pill px-4 py-2 fw-bold filter-pillar-btn" data-pillar="creative">Creative & Operations</button>
        </div>
      </div>
    </div>

    <!-- Search: the fastest way to find a service -->
    <div class="row justify-content-center mb-5" data-aos="fade-up">
      <div class="col-lg-8">
        <div class="search-input-wrap position-relative">
          <i class="fa-solid fa-magnifying-glass position-absolute text-muted search-icon-left" style="top: 50%; left: 20px; transform: translateY(-50%);" aria-hidden="true"></i>
          <input type="search" id="service-search" class="form-control form-control-lg ps-5 rounded-pill border-2" placeholder="Search services (e.g. AI, DevOps, Branding...)" aria-label="Search services">
        </div>
      </div>
    </div>

    <div id="catalogue-list">
    <% 
      const pillars = {
        'engineering': ['Foundry', 'Infrastructure', 'Labs', 'Next Vertical'],
        'intelligence': ['Intelligence', 'Growth', 'Academy'],
        'creative': ['Studio', 'Operations', 'Vitality', 'Voyage', 'Harvest']
      };
      const getPillar = (div) => {
        for (const [key, list] of Object.entries(pillars)) {
          if (list.includes(div)) return key;
        }
        return 'engineering';
      };

      const grouped = {}; 
      expertise.forEach(item => { 
        const div = String(item.division || '').trim(); 
        (grouped[div] = grouped[div] || []).push(item); 
      });
      const divOrder = Object.keys(grouped).sort((a, b) => (grouped[a][0].display_order ?? 0) - (grouped[b][0].display_order ?? 0)); 
    %>
    <% divOrder.forEach(div => { %>
      <% const pillar = getPillar(div); %>
      <div class="division-group mb-5" data-division="<%= slugify(div) %>" data-pillar="<%= pillar %>">
        <div class="d-flex align-items-baseline gap-3 mb-4 pt-2 border-bottom">
          <h2 class="h3 fw-black ls-tight mb-2"><%= div %></h2>
          <span class="badge rounded-pill bg-primary-subtle text-primary-emphasis fw-bold px-3"><%= grouped[div].length %> SERVICES</span>
        </div>
        <div class="row g-4">
        <% grouped[div].forEach(item => { %>
          <div class="col-12 col-md-6 col-lg-4 catalogue-card" data-pillar="<%= pillar %>" data-division="<%= slugify(div) %>" data-title="<%= String(item.title).toLowerCase() %>" data-desc="<%= String(item.short_description || '').toLowerCase() %>">
            <a href="/expertise/<%= encodeURIComponent(item.slug) %>" class="ecosystem-card">
              <div class="ecosystem-icon"><i class="fa-solid <%= item.icon || 'fa-code' %>"></i></div>
              <p class="small text-primary fw-bold mb-1 text-uppercase letter-spacing-01"><%= div %></p>
              <h3><%= item.title %></h3>
              <p><%= String(item.short_description || '').slice(0, 120) %>...</p>
            </a>
          </div>
        <% }); %>
        </div>
      </div>
    <% }); %>
    </div>

    <div class="text-center py-5" id="no-results" style="display:none;">
      <div class="ecosystem-icon mx-auto mb-4" style="width: 80px; height: 80px; font-size: 2rem;"><i class="fa-solid fa-magnifying-glass"></i></div>
      <h3 class="h4 fw-black">Nothing matches "<span id="no-results-term"></span>"</h3>
      <p class="text-secondary mb-4">Try a different keyword or explore a strategic pillar above.</p>
      <a href="/contact" class="btn btn-primary rounded-pill px-5 py-3 fw-bold">Start a custom project</a>
    </div>
  </div>
</section>

<script nonce="<%= cspNonce %>">
(function () {
  'use strict';
  var search = document.getElementById('service-search');
  var noResults = document.getElementById('no-results');
  var noTerm = document.getElementById('no-results-term');
  var groups = Array.prototype.slice.call(document.querySelectorAll('.division-group'));
  var pillarBtns = Array.prototype.slice.call(document.querySelectorAll('.filter-pillar-btn'));
  var state = { query: '', pillar: 'all' };

  var decoy = document.createElement('div');
  function decode(text) {
    decoy.innerHTML = String(text || '');
    return decoy.textContent || '';
  }

  function applyFilter() {
    var q = state.query.trim().toLowerCase();
    var p = state.pillar;
    var totalVisible = 0;

    groups.forEach(function (group) {
      var groupPillar = group.getAttribute('data-pillar');
      var cards = Array.prototype.slice.call(group.querySelectorAll('.catalogue-card'));
      var groupVisible = 0;

      cards.forEach(function (card) {
        var cardPillar = card.getAttribute('data-pillar');
        var pOk = (p === 'all' || cardPillar === p);
        var qOk = !q || decode(card.getAttribute('data-title')).indexOf(q) > -1 || decode(card.getAttribute('data-desc')).indexOf(q) > -1;
        var show = pOk && qOk;
        card.style.display = show ? '' : 'none';
        if (show) { groupVisible += 1; totalVisible += 1; }
      });

      group.style.display = (groupVisible > 0) ? '' : 'none';
    });

    if (noResults) {
      noResults.style.display = (totalVisible === 0) ? '' : 'none';
      noTerm.textContent = state.query || (p !== 'all' ? p + ' pillar' : 'your search');
    }
  }

  var timer = null;
  search.addEventListener('input', function () {
    clearTimeout(timer);
    timer = setTimeout(function () {
      state.query = search.value;
      applyFilter();
    }, 120);
  });

  pillarBtns.forEach(function(btn) {
    btn.addEventListener('click', function() {
      pillarBtns.forEach(function(b) { b.classList.remove('active'); });
      btn.classList.add('active');
      state.pillar = btn.getAttribute('data-pillar');
      applyFilter();
      window.scrollTo({ top: document.getElementById('capabilities').offsetTop - 100, behavior: 'smooth' });
    });
  });

  var params = new URLSearchParams(window.location.search);
  var initQ = params.get('q');
  if (initQ) { state.query = initQ; search.value = initQ; }
  applyFilter();
})();
</script>
<%- include('../layouts/footer', { settings, footerMenus, waLink }) %>
