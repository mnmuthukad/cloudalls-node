<%- include('../layouts/header', { pageTitle, pageDescription, pageKeywords, canonicalUrl, pageImage, settings, currentPage, socialLinks, schemaPhone }) %>
<section class="container-fluid bg-dark text-white py-5" style="background: radial-gradient(circle at 80% 20%, rgba(37,99,235,.35), transparent 38%), #0f172a;"><div class="container py-5"><p class="text-uppercase fw-bold text-info small ls-1 mb-3">Capabilities</p><h1 class="display-3 fw-black ls-tight mb-4">Technology that makes the complex usable.</h1><p class="lead text-white-50 mb-0" style="max-width: 760px;">Explore the CloudAlls ecosystem of practical engineering, AI, creative systems, and operational technology.</p></div></section>
<section class="container py-5"><div class="row g-4"><% expertise.forEach((item) => { %><article class="col-md-6 col-lg-4" data-aos="fade-up"><div class="h-100 p-4 rounded-4 border bg-white shadow-sm"><i class="fa-solid <%= item.icon || 'fa-code' %> fs-2 text-primary" aria-hidden="true"></i><h2 class="h4 fw-bold mt-4"><%= item.title %></h2><p class="text-secondary"><%= item.short_description || '' %></p><a class="btn btn-outline-primary rounded-pill" href="/expertise_details?slug=<%= encodeURIComponent(item.slug) %>">Explore capability</a></div></article><% }); %></div></section>
<%- include('../layouts/footer', { settings, footerMenus, waLink }) %>
