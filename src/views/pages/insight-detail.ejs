<%- include('../layouts/header', { pageTitle, pageDescription, pageKeywords, canonicalUrl, pageImage, settings, currentPage, socialLinks, schemaPhone }) %>
<script type="application/ld+json" nonce="<%= cspNonce %>"><%- JSON.stringify({ '@context': 'https://schema.org', '@type': 'Article', '@id': `${canonicalUrl}#article`, headline: insight.title, description: insight.excerpt || pageDescription, url: canonicalUrl, image: pageImage, datePublished: insight.created_at || undefined, author: { '@type': 'Organization', name: 'CloudAlls' }, publisher: { '@type': 'Organization', name: 'CloudAlls', logo: { '@type': 'ImageObject', url: `${canonicalUrl.split('/').slice(0, 3).join('/')}/assets/img/favicon.png` } }, mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl } }) %></script>
<article class="container py-5" style="max-width:900px;"><a href="/insights" class="small text-primary text-decoration-none fw-bold">&larr; Back to insights</a><p class="text-uppercase fw-bold text-info small ls-1 mt-5 mb-3">CloudAlls insight</p><h1 class="display-4 fw-black ls-tight mb-4"><%= insight.title %></h1><p class="lead text-secondary"><%= insight.excerpt || '' %></p><hr class="my-5"><div class="text-secondary" style="line-height:1.85; white-space:pre-line;"><%= (insight.content || insight.excerpt || '').replace(/<[^>]*>/g, '') %></div></article>
<%- include('../layouts/footer', { settings, footerMenus, waLink }) %>
