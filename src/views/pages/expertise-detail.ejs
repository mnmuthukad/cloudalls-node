<%- include('../layouts/header', { pageTitle, pageDescription, pageKeywords, canonicalUrl, pageImage, settings, currentPage, socialLinks, schemaPhone }) %>
<section class="container-fluid bg-dark text-white py-5"><div class="container py-5"><p class="text-uppercase fw-bold text-info small ls-1 mb-3">CloudAlls expertise</p><h1 class="display-3 fw-black ls-tight mb-4"><%= expertise.title %></h1><p class="lead text-white-50 mb-0" style="max-width: 780px;"><%= expertise.short_description || '' %></p></div></section>
<section class="container py-5"><div class="row g-5"><div class="col-lg-8"><h2 class="h2 fw-bold">A practical path to better systems.</h2><p class="lead text-secondary"><%= expertise.full_description || '' %></p><% if (expertise.bullet_points) { %><h3 class="h5 fw-bold mt-5">What we can deliver</h3><ul class="text-secondary"><% expertise.bullet_points.split(',').forEach((item) => { %><li class="mb-2"><%= item.trim() %></li><% }); %></ul><% } %></div><aside class="col-lg-4"><div class="p-4 rounded-4 bg-light border"><p class="small text-uppercase fw-bold text-primary">Engagement profile</p><p class="mb-2"><strong>Typical range:</strong> <%= expertise.price_range || 'Custom quoted' %></p><p class="mb-2"><strong>Delivery:</strong> <%= expertise.delivery_time || 'Defined during discovery' %></p><a href="/contact?service=<%= encodeURIComponent(expertise.title) %>" class="btn btn-primary rounded-pill mt-3">Discuss this capability</a></div></aside></div></section>
<%- include('../layouts/footer', { settings, footerMenus, waLink }) %>
