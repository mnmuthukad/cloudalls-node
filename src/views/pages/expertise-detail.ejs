<%- include('../layouts/header', { pageTitle, pageDescription, pageKeywords, canonicalUrl, pageImage, settings, currentPage, socialLinks, schemaPhone }) %>
<% const values = (value) => String(value || '').split(',').map(item => item.trim()).filter(Boolean); const deliverables = values(expertise.bullet_points); const services = values(expertise.sub_services); const benefits = values(expertise.key_benefits); %>
<section class="editorial-hero"><div class="container"><a href="/expertise" class="text-white-50 text-decoration-none small fw-bold text-uppercase"><i class="fa-solid fa-arrow-left me-2" aria-hidden="true"></i>Back to capabilities</a><p class="editorial-kicker mt-5 mb-3">CloudAlls capability</p><h1 class="mb-4"><%= expertise.title %></h1><p class="lead mb-0"><%= expertise.short_description || '' %></p><% if (expertise.division) { %><span class="badge rounded-pill bg-light text-primary border mt-3 px-4 py-2"><i class="fa-solid fa-building me-2" aria-hidden="true"></i>Operated by CloudAlls <%= expertise.division %></span><% } %></div></section>
<section class="editorial-section bg-white"><div class="container"><div class="row g-5"><div class="col-lg-8"><p class="section-kicker mb-3">Capability brief</p><h2 class="display-6 fw-bold mb-4">A practical path to better systems.</h2><p class="lead text-secondary lh-lg"><%= expertise.full_description || expertise.short_description || '' %></p><% if (deliverables.length) { %><h3 class="h4 fw-bold mt-5 mb-3">What we can deliver</h3><div class="row g-3"><% deliverables.forEach((item, index) => { %><div class="col-md-6"><div class="enterprise-card"><span class="home-proof-index"><%= String(index + 1).padStart(2, '0') %></span><p class="mb-0 mt-3 text-dark fw-semibold"><%= item %></p></div></div><% }); %></div><% } %></div><aside class="col-lg-4"><div class="capability-aside"><p class="section-kicker mb-3">Engagement profile</p><% if (expertise.price_range) { %><div class="capability-aside-row"><small>Typical range</small><strong><%= expertise.price_range %></strong></div><% } %><% if (expertise.delivery_time) { %><div class="capability-aside-row"><small>Delivery window</small><strong><%= expertise.delivery_time %></strong></div><% } %><a href="/contact?service=<%= encodeURIComponent(expertise.title) %>" class="btn btn-primary rounded-pill w-100 mt-4">Discuss this capability <i class="fa-solid fa-arrow-right ms-1" aria-hidden="true"></i></a><p class="small text-muted mt-3 mb-0">We will use a short discovery conversation to confirm scope, constraints, and the right engagement model.</p></div></aside></div></div></section>
<% if (services.length || benefits.length) { %><section class="editorial-section bg-light"><div class="container"><div class="row g-5"><% if (services.length) { %><div class="col-lg-6"><p class="section-kicker mb-3">Service areas</p><h2 class="h1 fw-bold mb-4">Where this capability shows up.</h2><div class="d-flex flex-wrap gap-2"><% services.forEach(item => { %><span class="badge rounded-pill text-bg-light border px-3 py-2"><%= item %></span><% }); %></div></div>
<% if (expertise.division) {
  const division = String(expertise.division || '').trim();
  const siblingServices = Array.isArray(siblingExpertise) ? siblingExpertise.filter(item => String(item.division || '').trim() === division && String(item.id) !== String(expertise.id)) : [];
  if (siblingServices.length) { %>
<div class="mt-4"><p class="small text-uppercase fw-bold text-muted mb-2">More under CloudAlls <%= expertise.division %></p><div class="d-flex flex-wrap gap-2"><% siblingServices.forEach(sibling => { %><a class="badge rounded-pill text-bg-light border text-primary text-decoration-none px-3 py-2" href="/expertise/<%= encodeURIComponent(sibling.slug) %>"><%= sibling.title %></a><% }); %></div></div>
<% } } %><% } %><% if (benefits.length) { %><div class="col-lg-6"><p class="section-kicker mb-3">Expected value</p><h2 class="h1 fw-bold mb-4">Designed around outcomes.</h2><ul class="list-unstyled d-grid gap-3 mb-0"><% benefits.forEach(item => { %><li class="d-flex gap-3 align-items-start text-secondary"><i class="fa-solid fa-circle-check text-primary mt-1" aria-hidden="true"></i><span><%= item %></span></li><% }); %></ul></div><% } %></div></div></section><% } %>
<section class="editorial-section bg-dark text-white"><div class="container"><div class="row align-items-center g-4"><div class="col-lg-8"><p class="section-kicker text-info mb-3">Next step</p><h2 class="h1 fw-bold mb-3">Let’s turn the requirement into a clear system.</h2><p class="lead text-white-50 mb-0">Bring the hard problem. We will help you identify the smallest useful path forward.</p></div><div class="col-lg-4 text-lg-end"><a href="/contact?service=<%= encodeURIComponent(expertise.title) %>" class="btn btn-light btn-lg rounded-pill px-4">Start a conversation</a></div></div></div></section>
<%- include('../layouts/footer', { settings, footerMenus, waLink }) %>
