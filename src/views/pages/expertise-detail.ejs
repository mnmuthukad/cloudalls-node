<%- include('../layouts/header', { pageTitle, pageDescription, pageKeywords, canonicalUrl, pageImage, settings, currentPage, socialLinks, schemaPhone }) %>

<link rel="stylesheet" href="/assets/css/premium.css">

<%
  const color = expertise.color || '#0B55ED';
  const values = (value) => String(value || '').split(',').map(item => item.trim()).filter(Boolean);
  const deliverables = values(expertise.what_we_deliver);
  const services = values(expertise.sub_services);
  const benefits = values(expertise.key_benefits);
  const useCases = values(expertise.use_cases);
  const techStack = values(expertise.tech_stack);
  let processSteps = [];
  try { const pd = JSON.parse(expertise.process_detail || '[]'); processSteps = Array.isArray(pd) ? pd : []; } catch (e) { processSteps = []; }
  const division = String(expertise.division || '').trim();
  const siblingServices = Array.isArray(siblingExpertise) ? siblingExpertise.filter(item => String(item.division || '').trim() === division && String(item.id) !== String(expertise.id)).slice(0, 3) : [];
%>

<!-- Premium Hero -->
<section class="home-hero-mnc" style="min-height: 55vh; padding-top: 140px; padding-bottom: 60px; background: linear-gradient(135deg, #0A2860 0%, <%= color %> 110%);">
    <div class="hero-grid-premium" aria-hidden="true" style="opacity: 0.1;"></div>
    <div class="container position-relative">
        <div class="row align-items-center g-4">
            <div class="col-lg-8">
                <nav aria-label="breadcrumb" class="mb-4" data-aos="fade-up">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="/expertise" class="text-white-50 text-decoration-none small fw-bold text-uppercase ls-1">Expertise</a></li>
                        <li class="breadcrumb-item active text-white small text-uppercase ls-1" aria-current="page"><%= division %></li>
                    </ol>
                </nav>
                <h1 class="hero-title-mnc mb-4" style="font-size: clamp(2rem, 5vw, 3.5rem);" data-aos="fade-up" data-aos-delay="100">
                    <%= expertise.title %>
                </h1>
                <p class="hero-lead-mnc" data-aos="fade-up" data-aos-delay="200">
                    <%= expertise.short_description || '' %>
                </p>
                <div class="d-flex flex-wrap gap-3 mt-5" data-aos="fade-up" data-aos-delay="300">
                    <a href="/contact?service=<%= encodeURIComponent(expertise.title) %>" class="btn btn-light btn-lg rounded-pill px-5 py-3 fw-bold" style="font-size: 1rem;">Start a project</a>
                    <a href="#overview" class="btn btn-outline-light btn-lg rounded-pill px-5 py-3 fw-bold" style="font-size: 1rem;">Read details</a>
                </div>
            </div>
            <div class="col-lg-4 d-none d-lg-block text-center" data-aos="zoom-in" data-aos-delay="400">
                <div class="d-flex align-items-center justify-content-center rounded-circle mx-auto" style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); width: 220px; height: 220px;">
                    <i class="fa-solid <%= expertise.icon || 'fa-cube' %> text-white" style="font-size: 70px;"></i>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Overview -->
<section class="ecosystem-section bg-white" id="overview">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-8" data-aos="fade-up">
                <span class="section-kicker">Overview</span>
                <h2 class="h3 fw-bold mb-4" style="color: var(--mnc-navy);">A practical path to better outcomes.</h2>
                <div class="editorial-content text-secondary" style="font-size: 1.05rem; line-height: 1.8;">
                    <%= expertise.full_description || expertise.short_description || '' %>
                </div>
            </div>
            <aside class="col-lg-4">
                <div class="p-4 p-lg-5 rounded-4 bg-light border sticky-top shadow-sm" style="top: 100px;" data-aos="fade-left">
                    <span class="small text-uppercase fw-bold text-muted ls-1 d-block mb-4" style="font-size: 0.65rem;">Engagement Profile</span>
                    
                    <div class="mb-4 pb-3 border-bottom">
                        <small class="text-muted d-block mb-1" style="font-size: 0.7rem;">Division</small>
                        <strong class="text-dark small">CloudAlls <%= expertise.division || '—' %></strong>
                    </div>
                    
                    <% if (expertise.delivery_time) { %>
                        <div class="mb-4 pb-3 border-bottom">
                            <small class="text-muted d-block mb-1" style="font-size: 0.7rem;">Delivery Window</small>
                            <strong class="text-dark small"><%= expertise.delivery_time %></strong>
                        </div>
                    <% } %>

                    <a href="/contact?service=<%= encodeURIComponent(expertise.title) %>" class="btn btn-primary btn-lg w-100 rounded-pill fw-bold py-3 small mt-2">
                        Discuss project <i class="fa-solid fa-arrow-right ms-2"></i>
                    </a>
                    <p class="small text-muted mt-4 mb-0" style="line-height: 1.5; font-size: 0.75rem;">A discovery conversation confirms scope, constraints, and the right engagement model.</p>
                </div>
            </aside>
        </div>
    </div>
</section>

<!-- Deliverables & Tech -->
<section class="ecosystem-section bg-light border-top border-bottom">
    <div class="container">
        <div class="row g-5">
            <% if (deliverables.length) { %>
                <div class="col-lg-7" data-aos="fade-up">
                    <span class="section-kicker">Deliverables</span>
                    <h2 class="h4 fw-bold mb-4" style="color: var(--mnc-navy);">What you actually receive.</h2>
                    <div class="row g-3">
                        <% deliverables.forEach((item, index) => { %>
                            <div class="col-md-6">
                                <div class="bg-white border rounded-3 p-3 shadow-sm h-100 d-flex align-items-center gap-3">
                                    <span class="text-info fw-bold small"><%= String(index + 1).padStart(2, '0') %></span>
                                    <span class="small text-dark fw-semibold" style="line-height: 1.4;"><%= item %></span>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                </div>
            <% } %>

            <% if (techStack.length) { %>
                <div class="col-lg-5" data-aos="fade-up" data-aos-delay="100">
                    <span class="section-kicker">Technology</span>
                    <h2 class="h4 fw-bold mb-4" style="color: var(--mnc-navy);">Building with.</h2>
                    <div class="d-flex flex-wrap gap-2">
                        <% techStack.forEach(item => { %>
                            <span class="badge rounded-pill border bg-white px-3 py-2 text-dark small fw-semibold"><%= item %></span>
                        <% }); %>
                    </div>
                </div>
            <% } %>
        </div>
    </div>
</section>

<!-- Process -->
<% if (processSteps.length) { %>
    <section class="ecosystem-section bg-white" id="process">
        <div class="container">
            <div class="row mb-5 text-center" data-aos="fade-up">
                <div class="col-lg-8 mx-auto">
                    <span class="section-kicker">Delivery Model</span>
                    <h2 class="h3 fw-bold" style="color: var(--mnc-navy);">A clear path to production.</h2>
                </div>
            </div>
            <div class="row g-4">
                <% processSteps.forEach((step, index) => { %>
                    <div class="col-md-6 col-lg-3" data-aos="fade-up" data-aos-delay="<%= index * 50 %>">
                        <div class="ecosystem-card h-100">
                            <span class="text-info fw-bold d-block mb-3" style="font-size: 0.8rem;"><%= String(index + 1).padStart(2, '0') %></span>
                            <h3 class="h6 fw-bold text-dark mb-2"><%= step.step %></h3>
                            <p class="text-secondary small mb-0" style="line-height: 1.6;"><%= step.detail %></p>
                        </div>
                    </div>
                <% }); %>
            </div>
        </div>
    </section>
<% } %>

<!-- Final CTA -->
<section class="home-final-cta py-5">
    <div class="container py-lg-5 text-center">
        <span class="section-kicker text-info" data-aos="fade-up">Next Step</span>
        <h2 class="h2 fw-bold text-white mb-4" data-aos="fade-up" data-aos-delay="100">Let's blueprint the solution.</h2>
        <p class="text-white-50 small mb-5 mx-auto" style="max-width: 600px;" data-aos="fade-up" data-aos-delay="150">Bring the hard problem. We will help you identify the smallest useful path forward.</p>
        <a href="/contact?service=<%= encodeURIComponent(expertise.title) %>" class="btn btn-light btn-lg rounded-pill px-5 py-3 fw-bold" style="font-size: 1rem;" data-aos="fade-up" data-aos-delay="200">Start a conversation</a>
    </div>
</section>

<%- include('../layouts/footer', { settings, footerMenus, waLink }) %>
