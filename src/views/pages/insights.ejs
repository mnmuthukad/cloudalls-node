<%- include('../layouts/header', { pageTitle, pageDescription, pageKeywords, canonicalUrl, pageImage, settings, currentPage, socialLinks, schemaPhone }) %>
<section class="container-fluid bg-dark text-white py-5"><div class="container py-5"><p class="text-uppercase fw-bold text-info small ls-1 mb-3">CloudAlls insights</p><h1 class="display-3 fw-black ls-tight mb-4">Useful ideas for the systems ahead.</h1><p class="lead text-white-50 mb-0" style="max-width:760px;">Practical thinking on AI, engineering, security, design, and operational technology.</p></div></section>
<section class="container py-5"><div class="row g-4"><% if (insights.length) { insights.forEach(item => { %><article class="col-md-6 col-lg-4"><div class="h-100 rounded-4 border bg-white shadow-sm overflow-hidden"><% if (item.image_url) { %><img src="<%= item.image_url %>" alt="" class="w-100" width="800" height="450" loading="lazy" decoding="async"><% } %><div class="p-4"><p class="small text-muted mb-2"><%= item.created_at ? new Date(item.created_at).toLocaleDateString('en-IN') : '' %></p><h2 class="h4 fw-bold"><%= item.title %></h2><p class="text-secondary"><%= item.excerpt || '' %></p><a class="btn btn-outline-primary rounded-pill" href="/insights/<%= encodeURIComponent(item.slug) %>">Read insight</a></div></div></article><% }); } else { %><div class="col-12"><div class="p-5 rounded-4 bg-light border text-center"><h2 class="h4 fw-bold">Insights are being prepared.</h2><p class="text-secondary mb-0">Check back soon for new CloudAlls research and field notes.</p></div></div><% } %></div></section>
<%- include('../layouts/footer', { settings, footerMenus, waLink }) %>
