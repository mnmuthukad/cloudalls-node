<%- include('../layouts/header', { pageTitle, pageDescription, pageKeywords, canonicalUrl, pageImage, settings, currentPage, socialLinks, schemaPhone }) %>

<link rel="stylesheet" href="/assets/css/premium.css">

<!-- 1. MNC Hero Section -->
<section class="home-hero-mnc" aria-labelledby="hero-title">
  <div class="hero-grid-premium" aria-hidden="true"></div>
  <div class="container position-relative">
    <div class="row align-items-center">
      <div class="col-lg-8">
        <span class="hero-tagline" data-aos="fade-up">Built Wide. Built Deep.</span>
        <h1 id="hero-title" class="hero-title-mnc" data-aos="fade-up" data-aos-delay="100">
          Organizing the global <span>technology culture.</span>
        </h1>
        <p class="hero-lead-mnc" data-aos="fade-up" data-aos-delay="200">
          CloudAlls helps ambitious teams turn complex ideas into dependable digital products, AI workflows, and global operating systems.
        </p>
        <div class="d-flex flex-wrap gap-3" data-aos="fade-up" data-aos-delay="300">
          <a class="btn btn-primary btn-lg rounded-pill px-5 py-3 fw-bold" href="/contact">
            Start a project <i class="fa-solid fa-arrow-up-right-from-square ms-2"></i>
          </a>
          <a class="btn btn-outline-light btn-lg rounded-pill px-5 py-3 fw-bold" href="/expertise">
            See capabilities <i class="fa-solid fa-arrow-right ms-2"></i>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 2. The CloudAlls Ecosystem -->
<section class="ecosystem-section">
  <div class="container">
    <div class="row mb-5">
      <div class="col-lg-7">
        <span class="section-kicker">The CloudAlls Ecosystem</span>
        <h2 class="display-4 fw-black ls-tight">Twelve divisions. One unified standard.</h2>
        <p class="lead text-secondary mt-3">We redefine how technology is built and operated through specialized brand divisions that work in harmony.</p>
      </div>
    </div>
    
    <div class="ecosystem-grid">
      <!-- Foundry -->
      <a href="/expertise" class="ecosystem-card" data-aos="fade-up">
        <div class="ecosystem-icon"><i class="fa-solid fa-fire-burner"></i></div>
        <h3>Foundry</h3>
        <p>Strategic product design and rapid engineering for high-stakes digital launches.</p>
      </a>
      
      <!-- Intelligence -->
      <a href="/expertise" class="ecosystem-card" data-aos="fade-up" data-aos-delay="100">
        <div class="ecosystem-icon"><i class="fa-solid fa-brain"></i></div>
        <h3>Intelligence</h3>
        <p>AI strategy, custom LLM workflows, and intelligent decision-support systems.</p>
      </a>
      
      <!-- Infrastructure -->
      <a href="/engineering" class="ecosystem-card" data-aos="fade-up" data-aos-delay="200">
        <div class="ecosystem-icon"><i class="fa-solid fa-server"></i></div>
        <h3>Infrastructure</h3>
        <p>Global cloud architecture, security governance, and resilient data foundations.</p>
      </a>
      
      <!-- Studio -->
      <a href="/brand" class="ecosystem-card" data-aos="fade-up" data-aos-delay="300">
        <div class="ecosystem-icon"><i class="fa-solid fa-compass-drafting"></i></div>
        <h3>Studio</h3>
        <p>High-fidelity design systems, brand identity, and user experience architecture.</p>
      </a>

      <!-- Growth -->
      <a href="/methodology" class="ecosystem-card" data-aos="fade-up">
        <div class="ecosystem-icon"><i class="fa-solid fa-chart-line"></i></div>
        <h3>Growth</h3>
        <p>Performance engineering and data-driven optimization for digital scale.</p>
      </a>

      <!-- Operations -->
      <a href="/contact" class="ecosystem-card" data-aos="fade-up" data-aos-delay="100">
        <div class="ecosystem-icon"><i class="fa-solid fa-gears"></i></div>
        <h3>Operations</h3>
        <p>Improve adoption, resilience, governance, and long-term operational value.</p>
      </a>

      <!-- Academy -->
      <a href="https://academy.cloudalls.com/" target="_blank" class="ecosystem-card" data-aos="fade-up" data-aos-delay="200">
        <div class="ecosystem-icon"><i class="fa-solid fa-graduation-cap"></i></div>
        <h3>Academy</h3>
        <p>Specialized training and talent development for the new technology culture.</p>
      </a>

      <!-- Labs -->
      <a href="/labs" class="ecosystem-card" data-aos="fade-up" data-aos-delay="300">
        <div class="ecosystem-icon"><i class="fa-solid fa-flask-vial"></i></div>
        <h3>Labs <span class="badge bg-primary ms-2 small" style="font-size: 0.6rem;">BETA</span></h3>
        <p>R&D and experimental engineering exploring the next horizon of technology.</p>
      </a>
    </div>
  </div>
</section>

<!-- 3. Delivery Model -->
<section class="home-proof-strip home-proof-strip-premium" aria-label="Delivery model">
  <div class="container">
    <div class="row align-items-center g-5">
      <div class="col-lg-6">
        <span class="section-kicker">Delivery Model</span>
        <h2 class="display-5 fw-black text-white">From first decision to practical handover.</h2>
        <div class="home-path-step mt-4 text-white opacity-75">
          <span>01</span><div><strong>Frame</strong><small class="d-block mt-1">Make the opportunity and next decision visible.</small></div>
        </div>
        <div class="home-path-step mt-3 text-white">
          <span class="bg-primary border-primary">02</span><div><strong>Build</strong><small class="d-block mt-1">Turn the clearest path into a dependable system.</small></div>
        </div>
        <div class="home-path-step mt-3 text-white opacity-75">
          <span>03</span><div><strong>Operate</strong><small class="d-block mt-1">Leave the team with ownership and momentum.</small></div>
        </div>
      </div>
      <div class="col-lg-6">
        <div class="mac-window" data-aos="zoom-in">
          <div class="mac-header">
            <div class="mac-dot close"></div>
            <div class="mac-dot min"></div>
            <div class="mac-dot max"></div>
            <span class="ms-auto small text-secondary opacity-50">CloudAlls Engine v4.2</span>
          </div>
          <div class="mac-body">
            <div class="d-flex flex-column gap-3">
              <div class="mac-item">
                <div class="mac-icon text-primary"><i class="fa-solid fa-shield-check"></i></div>
                <div><h4 class="mac-title">Secure by design</h4><p class="mac-desc">SOC2-ready architecture and data handling.</p></div>
              </div>
              <div class="mac-item">
                <div class="mac-icon text-success"><i class="fa-solid fa-bolt"></i></div>
                <div><h4 class="mac-title">Performance optimized</h4><p class="mac-desc">Sub-second response times on global nodes.</p></div>
              </div>
              <div class="mac-item">
                <div class="mac-icon text-info"><i class="fa-solid fa-code-merge"></i></div>
                <div><h4 class="mac-title">Continuous delivery</h4><p class="mac-desc">Automated pipelines for zero-downtime scale.</p></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 4. Global Footprint -->
<section class="global-map-section">
  <div class="container">
    <div class="row g-5">
      <div class="col-md-3" data-aos="fade-up">
        <div class="metric-mnc">3</div>
        <div class="metric-label">Countries Served</div>
      </div>
      <div class="col-md-3" data-aos="fade-up" data-aos-delay="100">
        <div class="metric-mnc">24/7</div>
        <div class="metric-label">Active Telemetry</div>
      </div>
      <div class="col-md-3" data-aos="fade-up" data-aos-delay="200">
        <div class="metric-mnc">99.9%</div>
        <div class="metric-label">SLA Commitment</div>
      </div>
      <div class="col-md-3" data-aos="fade-up" data-aos-delay="300">
        <div class="metric-mnc">12</div>
        <div class="metric-label">Unified Divisions</div>
      </div>
    </div>
  </div>
</section>

<!-- 5. Final CTA -->
<section class="home-final-cta">
  <div class="container text-center py-5">
    <span class="section-kicker text-info" data-aos="fade-up">Ready when you are</span>
    <h2 class="display-3 fw-black text-white mb-5" data-aos="fade-up" data-aos-delay="100">Make the next move clearer.</h2>
    <a class="btn btn-light btn-lg rounded-pill px-5 py-3 fw-bold" href="/contact" data-aos="fade-up" data-aos-delay="200">
      Start a project <i class="fa-solid fa-arrow-up-right-from-square ms-2"></i>
    </a>
  </div>
</section>

