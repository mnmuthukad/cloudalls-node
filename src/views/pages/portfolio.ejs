<%- include('../layouts/header', { pageTitle, pageDescription, pageKeywords, canonicalUrl, pageImage, settings, currentPage, socialLinks, schemaPhone }) %>
<section class="container-fluid bg-dark text-white py-5"><div class="container py-5"><p class="text-uppercase fw-bold text-info small ls-1 mb-3">Selected work</p><h1 class="display-3 fw-black ls-tight mb-4">Case studies with operational weight.</h1><p class="lead text-white-50 mb-0" style="max-width:760px;">A selection of systems, products, and experiences shaped by the CloudAlls ecosystem.</p></div></section>
<section class="container py-5"><div class="row g-4"><% if (portfolios.length) { portfolios.forEach(item => { %><article class="col-md-6"><div class="h-100 rounded-4 border bg-white shadow-sm overflow-hidden"><% if (item.image_url) { %><img src="<%= item.image_url %>" alt="" class="w-100" width="1000" height="560" loading="lazy" decoding="async"><% } %><div class="p-4"><p class="small text-muted mb-2"><%= item.client_name || 'CloudAlls ecosystem' %></p><h2 class="h4 fw-bold"><%= item.title %></h2><p class="text-secondary"><%= item.short_desc || '' %></p><a class="btn btn-outline-primary rounded-pill" href="/portfolio_details?slug=<%= encodeURIComponent(item.slug) %>">View case study</a></div></div></article><% }); } else { %><div class="col-12"><div class="p-5 rounded-4 bg-light border text-center"><h2 class="h4 fw-bold">Case studies are being prepared.</h2><p class="text-secondary mb-0">Check back soon for selected CloudAlls work.</p></div></div><% } %></div></section>
<%- include('../layouts/footer', { settings, footerMenus, waLink }) %>
