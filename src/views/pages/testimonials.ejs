<%- include('../layouts/header', { pageTitle, pageDescription, pageKeywords, canonicalUrl, pageImage, settings, currentPage, socialLinks, schemaPhone }) %>

<link rel="stylesheet" href="/assets/css/premium.css">

<!-- Premium Hero -->
<section class="home-hero-mnc" style="min-height: 50vh; padding-top: 140px; padding-bottom: 60px;">
    <div class="hero-grid-premium" aria-hidden="true"></div>
    <div class="container position-relative">
        <div class="row">
            <div class="col-lg-10">
                <span class="hero-tagline" data-aos="fade-up">Client Perspective</span>
                <h1 class="hero-title-mnc mb-4" style="font-size: clamp(2rem, 5vw, 3.5rem);" data-aos="fade-up" data-aos-delay="100">
                    Proof that useful <span>systems compound.</span>
                </h1>
                <p class="hero-lead-mnc" data-aos="fade-up" data-aos-delay="200">
                    Read how organizations have used CloudAlls engineering, security, and operational capabilities to move with more confidence.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- Testimonials Grid -->
<section class="ecosystem-section bg-white">
    <div class="container">
        <div class="row g-4">
            <% testimonials.forEach((item, index) => { %>
                <article class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="<%= index * 50 %>">
                    <div class="ecosystem-card h-100 d-flex flex-column">
                        <div class="d-flex align-items-center gap-3 mb-4">
                            <% if (item.client_image) { %>
                                <img src="<%= item.client_image %>" alt="<%= item.client_name %>" class="rounded-circle" width="48" height="48" loading="lazy" referrerpolicy="no-referrer">
                            <% } else { %>
                                <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center fw-bold" style="width:48px;height:48px; font-size: 0.9rem;">
                                    <%= item.client_name.slice(0, 1) %>
                                </div>
                            <% } %>
                            <div>
                                <h2 class="h6 fw-bold text-dark mb-1"><%= item.client_name %></h2>
                                <p class="small text-muted mb-0" style="font-size: 0.7rem;"><%= item.client_role || 'CloudAlls client' %></p>
                            </div>
                        </div>
                        <p class="text-secondary small flex-grow-1 mb-4" style="line-height: 1.6; font-style: italic;">
                            “<%= item.review_text %>”
                        </p>
                        <div class="text-warning small" aria-label="<%= item.rating || 5 %> out of 5 stars">
                            <% for (let star = 0; star < (item.rating || 5); star++) { %>
                                <i class="fa-solid fa-star me-1"></i>
                            <% } %>
                        </div>
                    </div>
                </article>
            <% }); %>
        </div>
    </div>
</section>

<!-- Final CTA -->
<section class="home-final-cta py-5">
    <div class="container py-lg-5 text-center">
        <h2 class="h2 fw-bold text-white mb-4" data-aos="fade-up">Build the next proof point.</h2>
        <p class="text-white-50 small mb-5 mx-auto" style="max-width: 600px;" data-aos="fade-up" data-aos-delay="100">Tell us what your organization needs to make clearer, safer, or more useful.</p>
        <a class="btn btn-light btn-lg rounded-pill px-5 py-3 fw-bold" style="font-size: 1rem;" href="/contact" data-aos="fade-up" data-aos-delay="200">Start a conversation</a>
    </div>
</section>

<%- include('../layouts/footer', { settings, footerMenus, waLink }) %>
