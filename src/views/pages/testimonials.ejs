<section class="container-fluid bg-dark text-white py-5" style="background:radial-gradient(circle at 80% 20%,rgba(37,99,235,.35),transparent 38%),#0f172a;"><div class="container py-5"><p class="text-uppercase fw-bold text-info small ls-1 mb-3">Client perspective</p><h1 class="display-3 fw-black ls-tight mb-4">Proof that useful systems compound.</h1><p class="lead text-white-50 mb-0" style="max-width:760px;">Read how organizations have used CloudAlls engineering, security, creative, and operational capabilities to move with more confidence.</p></div></section>
<section class="container py-5"><div class="row g-4"><% testimonials.forEach((item, index) => { %><article class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="<%= index * 60 %>"><div class="h-100 p-4 rounded-4 border bg-white shadow-sm d-flex flex-column"><div class="d-flex align-items-center gap-3 mb-4"><% if (item.client_image) { %><img src="<%= item.client_image %>" alt="<%= item.client_name %>" class="rounded-circle" width="52" height="52" loading="lazy" referrerpolicy="no-referrer"><% } else { %><div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold" style="width:52px;height:52px;"><%= item.client_name.slice(0, 1) %></div><% } %><div><h2 class="h6 fw-bold mb-1"><%= item.client_name %></h2><p class="small text-secondary mb-0"><%= item.client_role || 'CloudAlls client' %></p></div></div><p class="text-secondary flex-grow-1 mb-4">“<%= item.review_text %>”</p><div class="text-warning" aria-label="<%= item.rating || 5 %> out of 5 stars"><% for (let star = 0; star < (item.rating || 5); star++) { %><i class="fa-solid fa-star me-1" aria-hidden="true"></i><% } %></div></div></article><% }); %></div><div class="mt-5 p-5 rounded-4 bg-light border text-center"><h2 class="h3 fw-bold">Build the next proof point.</h2><p class="text-secondary mb-4">Tell us what your organization needs to make clearer, safer, or more useful.</p><a class="btn btn-primary btn-lg rounded-pill px-4" href="/contact">Start a conversation</a></div></section>
<%- include('../layouts/footer', { settings, footerMenus, waLink }) %>
