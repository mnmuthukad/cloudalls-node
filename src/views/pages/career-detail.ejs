<%- include('../layouts/header', { pageTitle, pageDescription, pageKeywords, canonicalUrl, pageImage, settings, currentPage, socialLinks, schemaPhone, recaptchaSiteKey }) %>
<% const roleEnd = String(job.end_date || '').slice(0, 10); const roleExpired = Boolean(roleEnd && roleEnd < new Date().toISOString().slice(0, 10)); %>
<script type="application/ld+json" nonce="<%= cspNonce %>"><%- JSON.stringify({ '@context': 'https://schema.org', '@type': 'JobPosting', title: job.title, description: (job.description || '').replace(/<[^>]*>/g, ''), validThrough: job.end_date || undefined, employmentType: job.type, directApply: true, hiringOrganization: { '@type': 'Organization', name: 'CloudAlls Ecosystem', sameAs: canonicalUrl.split('/careers/')[0] }, jobLocation: { '@type': 'Place', address: { '@type': 'PostalAddress', addressLocality: job.location, addressCountry: 'IN' } }, ...(job.location_type === 'Remote' ? { jobLocationType: 'TELECOMMUTE' } : {}) }) %></script>
<section class="container-fluid bg-dark text-white py-5"><div class="container py-5"><a href="/careers" class="text-white-50 text-decoration-none small fw-bold text-uppercase">&larr; Back to careers hub</a><div class="d-flex flex-wrap gap-2 mt-4 mb-3"><span class="badge bg-primary rounded-pill px-3 py-2"><%= job.department %></span><span class="badge <%= roleExpired ? 'bg-danger' : 'bg-light text-dark' %> rounded-pill px-3 py-2"><%= roleExpired ? 'Closed role' : job.type %></span></div><h1 class="display-3 fw-black ls-tight mb-3"><%= job.title %></h1><p class="text-white-50 mb-0"><%= job.location_type %> · <%= job.location %></p></div></section>
<section class="container py-5"><% if (formStatus) { %><div class="alert <%= formStatus === 'success' ? 'alert-success' : 'alert-danger' %> border-0 rounded-4" role="status"><strong><%= formStatus === 'success' ? 'Application transmitted.' : 'Application could not be submitted.' %></strong> <%= formStatus === 'success' ? "Your profile has been routed to our talent pipeline." : "" %><% if (formStatus !== 'success' && formStatus !== 'closed') { %><%= formErrorMsg === 'verification' ? 'Security verification did not pass &mdash; please disable ad-blockers, complete the page fully, and try again.' : 'All fields are required &mdash; including a full URL for portfolio or resume (starting with https://), and a phone number.' %><% } else if (formStatus === 'closed') { %>This role is closed.<% } %></div><% } %><div class="row g-5"><article class="col-lg-8"><div class="p-4 p-lg-5 rounded-4 bg-white border shadow-sm"><p class="text-uppercase fw-bold text-primary small ls-1 mb-2">Role overview</p><h2 class="h4 fw-bold border-bottom pb-3 mb-4"><%= roleExpired ? 'Role archive' : 'What you will work on' %></h2><div class="text-secondary" style="line-height:1.8; white-space:pre-line;"><%= (job.description || 'Role description will be published soon.').replace(/<[^>]*>/g, '') %></div><% if (roleExpired) { %><div class="alert alert-light border mt-4 mb-0"><i class="fa-solid fa-clock-rotate-left me-2" aria-hidden="true"></i>This opportunity is closed, but the role history remains available for reference. Please visit the careers hub for current openings.</div><% } %></div></article><aside class="col-lg-4"><div class="p-4 rounded-4 bg-light border sticky-top" style="top:100px;"><% if (roleExpired) { %><h2 class="h5 fw-bold">This role is closed.</h2><p class="small text-secondary">We are not accepting applications for this listing. You can still introduce yourself through our <a href="/contact">contact page</a>.</p><a class="btn btn-outline-dark w-100 rounded-pill fw-bold" href="/contact">Contact CloudAlls</a><% } else { %><h2 class="h5 fw-bold">Ready to build?</h2><p class="small text-secondary">Submit your profile directly to our talent pipeline.</p><form action="/careers/<%= encodeURIComponent(String(job.id)) %>" method="post" data-recaptcha-action="job_application"><input type="hidden" name="submit_internal_application" value="1"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><input type="hidden" name="recaptcha_token" value=""><input class="bot-trap" type="text" name="bot_trap" tabindex="-1" autocomplete="off" aria-hidden="true"><label class="form-label small fw-bold" for="first-name">First name</label><input class="form-control mb-3" id="first-name"  name="first_name" maxlength="100" required<%= typeof formValues !== "undefined" && formValues.firstName ? String(formValues.firstName).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;') : "" %>><label class="form-label small fw-bold" for="last-name">Last name</label><input class="form-control mb-3" id="last-name"  name="last_name" maxlength="100" required<%= typeof formValues !== "undefined" && formValues.lastName ? String(formValues.lastName).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;') : "" %>><label class="form-label small fw-bold" for="career-email">Email</label><input class="form-control mb-3" id="career-email"  name="email" type="email" maxlength="320" required<%= typeof formValues !== "undefined" && formValues.email ? String(formValues.email).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;') : "" %>><label class="form-label small fw-bold" for="career-phone">Phone</label><input class="form-control mb-3" id="career-phone"  name="phone" maxlength="30" required<%= typeof formValues !== "undefined" && formValues.phone ? String(formValues.phone).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;') : "" %>><label class="form-label small fw-bold" for="portfolio-url">Portfolio or resume URL</label><input class="form-control mb-3" id="portfolio-url"  name="portfolio_url" type="url" placeholder="https://" maxlength="500" required<%= typeof formValues !== "undefined" && formValues.portfolioUrl ? String(formValues.portfolioUrl).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;') : "" %>><label class="form-label small fw-bold" for="cover-letter">Cover letter</label><textarea class="form-control mb-3" id="cover-letter" name="cover_letter" rows="5" maxlength="10000" required><%= typeof formValues !== "undefined" && formValues.coverLetter ? String(formValues.coverLetter).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;') : "" %></textarea><button class="btn btn-dark w-100 rounded-pill fw-bold" type="submit">Submit application</button></form><% } %></div></aside></div></section>
<%- include('../layouts/footer', { settings, footerMenus, waLink }) %>
