<%- include('../layouts/header', { pageTitle, pageDescription, pageKeywords, canonicalUrl, pageImage, settings, currentPage, socialLinks, schemaPhone, recaptchaSiteKey }) %>

<link rel="stylesheet" href="/assets/css/premium.css">

<% 
    const roleEnd = String(job.end_date || '').slice(0, 10); 
    const roleExpired = Boolean(roleEnd && roleEnd < new Date().toISOString().slice(0, 10)); 
%>

<script type="application/ld+json" nonce="<%= cspNonce %>">
<%- JSON.stringify({ 
    '@context': 'https://schema.org', 
    '@type': 'JobPosting', 
    title: job.title, 
    description: (job.description || '').replace(/<[^>]*>/g, ''), 
    validThrough: job.end_date || undefined, 
    employmentType: job.type, 
    directApply: true, 
    hiringOrganization: { '@type': 'Organization', name: 'CloudAlls Ecosystem', sameAs: canonicalUrl.split('/careers/')[0] }, 
    jobLocation: { '@type': 'Place', address: { '@type': 'PostalAddress', addressLocality: job.location, addressCountry: 'IN' } }, 
    ...(job.location_type === 'Remote' ? { jobLocationType: 'TELECOMMUTE' } : {}) 
}) %>
</script>

<!-- Premium Career Hero -->
<section class="home-hero-mnc" style="min-height: 50vh; padding-top: 140px; padding-bottom: 60px;">
    <div class="hero-grid-premium" aria-hidden="true"></div>
    <div class="container position-relative">
        <div class="row">
            <div class="col-lg-10">
                <nav aria-label="breadcrumb" class="mb-4" data-aos="fade-up">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="/careers" class="text-info text-decoration-none small fw-bold text-uppercase ls-1">Careers</a></li>
                        <li class="breadcrumb-item active text-white-50 small text-uppercase ls-1" aria-current="page">Role Details</li>
                    </ol>
                </nav>
                <h1 class="hero-title-mnc mb-4" style="font-size: clamp(2rem, 5vw, 3.5rem);" data-aos="fade-up" data-aos-delay="100">
                    <%= job.title %>
                </h1>
                <div class="d-flex flex-wrap align-items-center gap-4" data-aos="fade-up" data-aos-delay="200">
                    <div class="small text-white-50 text-uppercase ls-1" style="font-size: 0.7rem;">
                        <span class="text-info me-2">Division:</span> <%= job.department %>
                    </div>
                    <div class="small text-white-50 text-uppercase ls-1" style="font-size: 0.7rem;">
                        <span class="text-info me-2">Location:</span> <%= job.location_type %> · <%= job.location %>
                    </div>
                    <div class="small text-white-50 text-uppercase ls-1">
                        <span class="badge rounded-pill px-3 py-2 <%= roleExpired ? 'bg-danger' : 'bg-primary' %>" style="font-size: 0.65rem;">
                            <%= roleExpired ? 'Closed Role' : job.type %>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Application Section -->
<section class="ecosystem-section py-5 bg-white">
    <div class="container py-lg-4">
        <% if (formStatus) { %>
            <div class="row justify-content-center mb-5">
                <div class="col-lg-10">
                    <div class="alert <%= formStatus === 'success' ? 'alert-success' : 'alert-danger' %> border-0 rounded-4 p-4 shadow-sm" role="status" data-aos="fade-up">
                        <div class="d-flex align-items-center gap-3">
                            <i class="fa-solid <%= formStatus === 'success' ? 'fa-circle-check' : 'fa-circle-exclamation' %> fa-2x"></i>
                            <div>
                                <strong class="d-block mb-1 small text-uppercase ls-1"><%= formStatus === 'success' ? 'Application transmitted.' : 'Submission Error' %></strong>
                                <span class="small"><%= formStatus === 'success' ? "Your profile has been successfully routed to our talent pipeline." : (formErrorMsg === 'verification' ? 'Security verification failed. Please try again.' : 'Please check all fields and try again.') %></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        <% } %>

        <div class="row g-5">
            <!-- Role Details -->
            <article class="col-lg-8">
                <div class="p-4 p-lg-5 rounded-4 bg-white border shadow-sm" data-aos="fade-up">
                    <span class="section-kicker">Role Overview</span>
                    <h2 class="h4 fw-bold mb-4" style="color: var(--mnc-navy);"><%= roleExpired ? 'Role Archive' : 'What you will build' %></h2>
                    
                    <div class="text-secondary editorial-content" style="font-size: 1rem; line-height: 1.7; white-space: pre-line;">
                        <%= (job.description || 'Role description will be published soon.').replace(/<[^>]*>/g, '') %>
                    </div>

                    <% if (roleExpired) { %>
                        <div class="alert alert-light border mt-5 mb-0 rounded-4">
                            <div class="d-flex gap-3">
                                <i class="fa-solid fa-clock-rotate-left text-muted"></i>
                                <p class="small text-muted mb-0">This opportunity is closed, but the role history remains available for reference. Please visit the careers hub for current openings.</p>
                            </div>
                        </div>
                    <% } %>
                </div>
            </article>

            <!-- Application Form Sidebar -->
            <aside class="col-lg-4">
                <div class="p-4 p-lg-5 rounded-4 bg-light border sticky-top shadow-sm" style="top: 100px;" data-aos="fade-left">
                    <% if (roleExpired) { %>
                        <h3 class="h5 fw-bold mb-3 text-dark">Role Closed</h3>
                        <p class="small text-secondary mb-4">We are not currently accepting applications for this specific listing.</p>
                        <a class="btn btn-outline-dark w-100 rounded-pill fw-bold py-3 small" href="/careers">Return to Careers</a>
                    <% } else { %>
                        <h3 class="h5 fw-bold mb-3 text-dark">Apply Now</h3>
                        <p class="small text-secondary mb-4">Submit your profile to our talent pipeline.</p>
                        
                        <form action="/careers/<%= encodeURIComponent(String(job.id)) %>" method="post" data-recaptcha-action="job_application" class="row g-3">
                            <input type="hidden" name="submit_internal_application" value="1">
                            <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                            <input type="hidden" name="recaptcha_token" value="">
                            <input class="bot-trap" type="text" name="bot_trap" tabindex="-1" autocomplete="off" aria-hidden="true">
                            
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-uppercase ls-1" style="font-size: 0.65rem;" for="first-name">First Name</label>
                                <input class="form-control rounded-3" style="font-size: 0.9rem;" id="first-name" name="first_name" required value="<%= typeof formValues !== "undefined" && formValues.firstName ? String(formValues.firstName).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;') : "" %>">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-uppercase ls-1" style="font-size: 0.65rem;" for="last-name">Last Name</label>
                                <input class="form-control rounded-3" style="font-size: 0.9rem;" id="last-name" name="last_name" required value="<%= typeof formValues !== "undefined" && formValues.lastName ? String(formValues.lastName).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;') : "" %>">
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-bold text-uppercase ls-1" style="font-size: 0.65rem;" for="career-email">Email Address</label>
                                <input class="form-control rounded-3" style="font-size: 0.9rem;" id="career-email" name="email" type="email" required value="<%= typeof formValues !== "undefined" && formValues.email ? String(formValues.email).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;') : "" %>">
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-bold text-uppercase ls-1" style="font-size: 0.65rem;" for="career-phone">Phone Number</label>
                                <input class="form-control rounded-3" style="font-size: 0.9rem;" id="career-phone" name="phone" required value="<%= typeof formValues !== "undefined" && formValues.phone ? String(formValues.phone).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;') : "" %>">
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-bold text-uppercase ls-1" style="font-size: 0.65rem;" for="portfolio-url">Portfolio or Resume URL</label>
                                <input class="form-control rounded-3" style="font-size: 0.9rem;" id="portfolio-url" name="portfolio_url" type="url" placeholder="https://" required value="<%= typeof formValues !== "undefined" && formValues.portfolioUrl ? String(formValues.portfolioUrl).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;') : "" %>">
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-bold text-uppercase ls-1" style="font-size: 0.65rem;" for="cover-letter">Cover Letter / Note</label>
                                <textarea class="form-control rounded-3" style="font-size: 0.9rem;" id="cover-letter" name="cover_letter" rows="4" required><%= typeof formValues !== "undefined" && formValues.coverLetter ? String(formValues.coverLetter).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;') : "" %></textarea>
                            </div>
                            <div class="col-12 mt-4">
                                <button class="btn btn-dark btn-lg w-100 rounded-pill fw-bold py-3 small" type="submit">Submit Application</button>
                            </div>
                        </form>
                    <% } %>
                </div>
            </aside>
        </div>
    </div>
</section>

<%- include('../layouts/footer', { settings, footerMenus, waLink }) %>
