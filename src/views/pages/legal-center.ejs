<%- include('../layouts/header', { pageTitle, pageDescription, pageKeywords, canonicalUrl, pageImage, settings, currentPage, socialLinks, schemaPhone }) %>
<section class="editorial-hero"><div class="container"><p class="editorial-kicker mb-3">Trust, governance and data rights</p><h1 class="mb-4">Legal clarity for connected systems.</h1><p class="lead mb-0">Review the policies, operating principles, incident approach, and jurisdiction-aware reference frameworks that shape the CloudAlls ecosystem.</p></div></section>
<section class="editorial-section bg-white"><div class="container"><div class="row align-items-end g-4 mb-5"><div class="col-lg-8"><p class="section-kicker mb-3">Policy library</p><h2 class="display-6 fw-bold mb-3">The documents that set expectations.</h2><p class="text-secondary lead mb-0">Read the policies that govern public platforms, privacy, security, responsible use, ethics, and accessibility.</p></div><div class="col-lg-4 text-lg-end"><a class="btn btn-primary rounded-pill px-4" href="/data-requests">Submit a data request <i class="fa-solid fa-arrow-right ms-2" aria-hidden="true"></i></a></div></div><div class="row g-4"><% if (directory.length) { directory.forEach((item, index) => { %><div class="col-md-6 col-lg-4"><a class="enterprise-card d-block text-decoration-none" href="<%= item.link %>"><span class="d-flex align-items-center justify-content-between mb-4"><span class="capability-icon mb-0"><i class="fa-solid <%= item.icon %>" aria-hidden="true"></i></span><span class="small text-muted fw-bold"><%= String(index + 1).padStart(2, '0') %></span></span><h3 class="h5 fw-bold text-dark"><%= item.title %></h3><p class="mb-0"><%= item.description %></p></a></div><% }); } else { %><div class="col-12"><div class="alert alert-light border">The policy directory is temporarily unavailable. Please use the contact channel for an official request.</div></div><% } %></div></div></section>
<section class="editorial-section bg-light"><div class="container"><div class="row g-5"><div class="col-lg-5"><p class="section-kicker mb-3">Operating principles</p><h2 class="display-6 fw-bold mb-3">Trust is designed into the system.</h2><p class="text-secondary lead">These imported compliance pillars describe the intended standard for data, assurance, privacy, and transparency.</p></div><div class="col-lg-7"><div class="row g-3"><% pillars.forEach((pillar) => { %><div class="col-md-6"><div class="enterprise-card"><span class="capability-icon"><i class="fa-solid <%= pillar.icon %>" aria-hidden="true"></i></span><h3 class="h5 fw-bold"><%= pillar.title %></h3><p class="mb-0"><%= pillar.description %></p></div></div><% }); %></div></div></div></div></section>
<section class="editorial-section bg-white"><div class="container"><div class="row g-5"><div class="col-lg-5"><p class="section-kicker mb-3">Incident response</p><h2 class="display-6 fw-bold mb-3">A calm response when the unexpected happens.</h2><p class="text-secondary lead">The response model keeps containment, communication, and learning connected. Specific contractual commitments depend on the applicable engagement.</p></div><div class="col-lg-7"><div class="home-engagement-list"><% crisisResponse.forEach((step) => { %><div class="home-engagement-item"><span class="home-engagement-num"><%= String(step.step_number).padStart(2, '0') %></span><span><strong><%= step.title %></strong><small><%= step.description %></small></span><i class="fa-solid fa-arrow-right text-primary" aria-hidden="true"></i></div><% }); %></div></div></div></div></section>
<section class="editorial-section bg-light"><div class="container"><div class="row align-items-end g-4 mb-5"><div class="col-lg-8"><p class="section-kicker mb-3">Framework register</p><h2 class="display-6 fw-bold mb-3">References by jurisdiction, not blanket claims.</h2><p class="text-secondary lead mb-0">These entries are informational references for review. They are not a statement that CloudAlls is certified, universally compliant, or legally advised in every jurisdiction.</p></div></div><div class="row g-3"><% frameworks.forEach((framework) => { %><div class="col-12"><details class="enterprise-card framework-row"><summary class="d-flex flex-column flex-lg-row gap-3 align-items-lg-center justify-content-between"><span><strong class="d-block text-dark"><%= framework.framework_name %></strong><small class="text-muted"><%= framework.jurisdiction %> · <%= framework.framework_type %> · Reviewed <%= new Date(framework.last_reviewed).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) %></small></span><span class="badge rounded-pill text-bg-light border"><%= framework.review_status %></span></summary><div class="row g-3 mt-2"><div class="col-lg-8"><p class="mb-0"><%= framework.scope_summary %></p></div><div class="col-lg-4 text-lg-end"><p class="small text-muted mb-2"><%= framework.authority %></p><a href="<%= framework.source_url %>" target="_blank" rel="noopener noreferrer" class="small fw-bold text-primary">Open official reference <i class="fa-solid fa-arrow-up-right-from-square ms-1" aria-hidden="true"></i></a></div></div></details></div><% }); %></div></div></section>
<section class="editorial-section bg-dark text-white"><div class="container"><div class="row align-items-center g-4"><div class="col-lg-8"><p class="section-kicker text-info mb-3">Data subject requests</p><h2 class="h1 fw-bold mb-3">Need to access, modify, export, or delete personal data?</h2><p class="lead text-white-50 mb-0">Use the protected CloudAlls workflow. We verify identity and scope before handling a request.</p></div><div class="col-lg-4 text-lg-end"><a class="btn btn-light btn-lg rounded-pill px-4" href="/data-requests">Open DSR workflow</a></div></div></div></section>
<%- include('../layouts/footer', { settings, footerMenus, waLink }) %>
