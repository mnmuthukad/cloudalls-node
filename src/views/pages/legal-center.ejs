<section class="container-fluid bg-dark text-white py-5" style="background:radial-gradient(circle at 80% 20%,rgba(37,99,235,.35),transparent 38%),#0f172a;"><div class="container py-5"><p class="text-uppercase fw-bold text-info small ls-1 mb-3">Trust and compliance</p><h1 class="display-3 fw-black ls-tight mb-4">Legal clarity for connected systems.</h1><p class="lead text-white-50 mb-0" style="max-width:760px;">Review the policies that govern CloudAlls platforms, services, privacy, security, and responsible use.</p></div></section>
<section class="container py-5"><div class="row g-4"><% directory.forEach((item, index) => { %><article class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="<%= index * 50 %>"><a href="<%= item.link %>" class="d-block h-100 p-4 rounded-4 border bg-white shadow-sm text-decoration-none text-dark"><span class="text-primary fw-bold small"><%= String(index + 1).padStart(2, '0') %></span><h2 class="h5 fw-bold mt-3"><%= item.title %></h2><p class="text-secondary mb-0"><%= item.description %></p></a></article><% }); %><article class="col-md-6 col-lg-4" data-aos="fade-up"><a href="/data-requests" class="d-block h-100 p-4 rounded-4 border bg-dark text-white shadow-sm text-decoration-none"><span class="text-info fw-bold small">DSR</span><h2 class="h5 fw-bold mt-3">Data Subject Requests</h2><p class="text-white-50 mb-0">Request access, modification, portability, objection, or deletion of personal data.</p></a></article></div></section>
<%- include('../layouts/footer', { settings, footerMenus, waLink }) %>
