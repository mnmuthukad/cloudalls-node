<%- include('../layouts/header', { pageTitle, pageDescription, pageKeywords, canonicalUrl, pageImage, settings, currentPage, socialLinks, schemaPhone }) %>

<link rel="stylesheet" href="/assets/css/premium.css">

<!-- Premium Hero -->
<section class="home-hero-mnc" style="min-height: 50vh; padding-top: 140px; padding-bottom: 60px;">
    <div class="hero-grid-premium" aria-hidden="true"></div>
    <div class="container position-relative">
        <div class="row">
            <div class="col-lg-10">
                <span class="hero-tagline" data-aos="fade-up">Trust & Governance</span>
                <h1 class="hero-title-mnc mb-4" style="font-size: clamp(2rem, 5vw, 3.5rem);" data-aos="fade-up" data-aos-delay="100">
                    Legal clarity for <span>connected systems.</span>
                </h1>
                <p class="hero-lead-mnc" data-aos="fade-up" data-aos-delay="200">
                    Review the policies, operating principles, and reference frameworks that shape the CloudAlls ecosystem.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- Policy Library -->
<section class="ecosystem-section bg-white">
    <div class="container">
        <div class="row align-items-end g-4 mb-5" data-aos="fade-up">
            <div class="col-lg-8">
                <span class="section-kicker">Policy Library</span>
                <h2 class="h3 fw-bold mb-3" style="color: var(--mnc-navy);">The documents that set expectations.</h2>
                <p class="text-secondary small mb-0" style="line-height: 1.6;">Read the policies that govern public platforms, privacy, security, and ethics.</p>
            </div>
            <div class="col-lg-4 text-lg-end">
                <a class="btn btn-outline-primary rounded-pill px-4 fw-bold small" href="/data-requests">Data Request <i class="fa-solid fa-arrow-right ms-2"></i></a>
            </div>
        </div>

        <div class="row g-4">
            <% if (directory && directory.length) { directory.forEach((item, index) => { %>
                <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="<%= index * 50 %>">
                    <a class="ecosystem-card d-block text-decoration-none h-100" href="<%= item.link %>">
                        <div class="d-flex align-items-center justify-content-between mb-4">
                            <div class="ecosystem-icon mb-0" style="width: 40px; height: 40px; font-size: 1rem;">
                                <i class="fa-solid <%= item.icon %>"></i>
                            </div>
                            <span class="small text-muted fw-bold" style="font-size: 0.7rem;"><%= String(index + 1).padStart(2, '0') %></span>
                        </div>
                        <h3 class="h6 fw-bold text-dark mb-2"><%= item.title %></h3>
                        <p class="text-secondary small mb-0" style="line-height: 1.5;"><%= item.description %></p>
                    </a>
                </div>
            <% }); } %>
        </div>
    </div>
</section>

<!-- Operating Principles -->
<section class="ecosystem-section bg-light border-top border-bottom">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-5" data-aos="fade-up">
                <span class="section-kicker">Operating Principles</span>
                <h2 class="h3 fw-bold mb-3" style="color: var(--mnc-navy);">Trust is designed into the system.</h2>
                <p class="text-secondary small" style="line-height: 1.7;">These compliance pillars describe the intended standard for data, assurance, privacy, and transparency.</p>
            </div>
            <div class="col-lg-7">
                <div class="row g-3">
                    <% pillars.forEach((pillar, index) => { %>
                        <div class="col-md-6" data-aos="fade-up" data-aos-delay="<%= index * 50 %>">
                            <div class="ecosystem-card bg-white">
                                <div class="ecosystem-icon mb-3" style="width: 32px; height: 32px; font-size: 0.9rem;">
                                    <i class="fa-solid <%= pillar.icon %>"></i>
                                </div>
                                <h3 class="h6 fw-bold text-dark mb-2"><%= pillar.title %></h3>
                                <p class="text-secondary small mb-0" style="line-height: 1.5;"><%= pillar.description %></p>
                            </div>
                        </div>
                    <% }); %>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Final CTA -->
<section class="home-final-cta py-5">
    <div class="container py-lg-5 text-center">
        <span class="section-kicker text-info" data-aos="fade-up">Data Subject Requests</span>
        <h2 class="h2 fw-bold text-white mb-4" data-aos="fade-up" data-aos-delay="100">Need to manage your personal data?</h2>
        <p class="text-white-50 small mb-5 mx-auto" style="max-width: 600px;" data-aos="fade-up" data-aos-delay="150">Use the protected CloudAlls workflow. We verify identity and scope before handling any data request.</p>
        <a class="btn btn-light btn-lg rounded-pill px-5 py-3 fw-bold" style="font-size: 1rem;" href="/data-requests" data-aos="fade-up" data-aos-delay="200">Open DSR Workflow</a>
    </div>
</section>

<%- include('../layouts/footer', { settings, footerMenus, waLink }) %>
