<%- include('../layouts/header', { pageTitle, pageDescription, pageKeywords, canonicalUrl, pageImage, settings, currentPage, socialLinks, schemaPhone }) %>

<link rel="stylesheet" href="/assets/css/premium.css">

<!-- Premium Hero -->
<section class="home-hero-mnc" style="min-height: 70vh; padding-top: 160px;">
  <div class="hero-grid-premium" aria-hidden="true"></div>
  <div class="container position-relative">
    <div class="row align-items-center">
      <div class="col-lg-8">
        <span class="hero-tagline" data-aos="fade-up">Corporate Identity</span>
        <h1 class="hero-title-mnc" data-aos="fade-up" data-aos-delay="100">
          Engineering <span>intelligence.</span>
        </h1>
        <p class="hero-lead-mnc" data-aos="fade-up" data-aos-delay="200">
          CloudAlls is a full-spectrum technology company and hybrid innovation lab delivering AI, software, and infrastructure under one unified global ecosystem.
        </p>
        <div class="d-flex flex-wrap gap-3" data-aos="fade-up" data-aos-delay="300">
          <a class="btn btn-primary btn-lg rounded-pill px-5 py-3 fw-bold" href="/contact">Work with us</a>
          <a class="btn btn-outline-light btn-lg rounded-pill px-5 py-3 fw-bold" href="#origin-story">Our story</a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Strategic Advantage Section -->
<section class="ecosystem-section bg-white">
  <div class="container">
    <div class="row mb-5">
      <div class="col-lg-8">
        <span class="section-kicker">The CloudAlls Standard</span>
        <h2 class="display-4 fw-black ls-tight">Bridging digital innovation and real-world execution.</h2>
        <p class="lead text-secondary mt-4">
          <%= about.sections[0].body %>
        </p>
      </div>
    </div>

    <div class="ecosystem-grid">
      <% about.unique.forEach((item, index) => { %>
        <div class="ecosystem-card" data-aos="fade-up" data-aos-delay="<%= index * 100 %>">
          <div class="ecosystem-icon"><i class="fa-solid <%= item.icon %>"></i></div>
          <h3><%= item.title %></h3>
          <p><%= item.body %></p>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<!-- Innovation History -->
<section class="solution-explorer" id="origin-story">
  <div class="container">
    <div class="row mb-5 text-center">
      <div class="col-12">
        <span class="section-kicker text-info">Origin Story</span>
        <h2 class="display-4 fw-black text-white">The architecture of our evolution.</h2>
      </div>
    </div>

    <div class="row g-4">
      <% about.chapters.forEach((chapter, index) => { %>
        <div class="col-lg-4" data-aos="fade-up" data-aos-delay="<%= index * 100 %>">
          <div class="p-4 rounded-4 bg-white bg-opacity-5 border border-white border-opacity-10 h-100">
            <span class="text-info fw-black h1 d-block mb-3"><%= chapter.year %></span>
            <h3 class="h4 fw-bold text-white mb-3"><%= chapter.title %></h3>
            <p class="text-white opacity-75"><%= chapter.body %></p>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<!-- Leadership -->
<section class="ecosystem-section bg-white" id="leadership">
  <div class="container">
    <div class="row mb-5 text-center">
      <div class="col-12">
        <span class="section-kicker">Leadership</span>
        <h2 class="display-4 fw-black ls-tight">The architects behind the ecosystem.</h2>
      </div>
    </div>
    <div class="row g-4 justify-content-center">
      <% about.leadershipTeam.forEach((member, index) => { %>
        <div class="col-md-6 col-lg-3" data-aos="fade-up" data-aos-delay="<%= index * 100 %>">
          <div class="ecosystem-card p-0 overflow-hidden h-100">
            <img src="<%= member.image %>" alt="<%= member.title %>" class="img-fluid w-100" style="height: 250px; object-fit: cover;">
            <div class="p-4">
              <h3 class="h5 fw-black mb-1"><%= member.title %></h3>
              <p class="small fw-bold text-primary text-uppercase mb-2"><%= member.role %></p>
              <p class="small text-secondary mb-0"><%= member.description %></p>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<!-- Global Footprint Metric Strip -->
<section class="global-map-section">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-10">
        <div class="row g-4">
          <% (about.stats || []).forEach((stat, index) => { %>
            <div class="col-md-3" data-aos="zoom-in" data-aos-delay="<%= index * 100 %>">
              <div class="metric-mnc"><%= stat.value %></div>
              <div class="metric-label"><%= stat.label %></div>
            </div>
          <% }); %>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Final CTA -->
<section class="home-final-cta">
  <div class="container text-center py-5">
    <h2 class="display-4 fw-black text-white mb-4">Build the next ecosystem.</h2>
    <a class="btn btn-light btn-lg rounded-pill px-5 py-3 fw-bold" href="/contact">Start a project</a>
  </div>
</section>

<%- include('../layouts/footer', { settings, footerMenus, waLink }) %>
<script nonce="<%= cspNonce %>">document.addEventListener('DOMContentLoaded', () => { if (window.AOS) window.AOS.refresh(); });</script>
