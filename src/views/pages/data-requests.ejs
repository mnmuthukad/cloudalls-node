<%- include('../layouts/header', { pageTitle, pageDescription, pageKeywords, canonicalUrl, pageImage, settings, currentPage, socialLinks, schemaPhone, recaptchaSiteKey }) %>
<section class="container-fluid text-white py-5" style="background:linear-gradient(135deg,#0f172a,#1e293b);"><div class="container py-5"><p class="text-uppercase fw-bold text-info small ls-1 mb-3">Legal center</p><h1 class="display-3 fw-black ls-tight mb-3">Your data, your rights.</h1><p class="lead opacity-75 mb-0" style="max-width:760px;">Submit a secure Data Subject Request to access, modify, export, or delete personal information held by CloudAlls.</p></div></section>
<section class="py-5" style="background:#fafafa;"><div class="container py-4"><div class="row g-5"><div class="col-lg-5"><h2 class="h3 fw-black mb-4">Data operations desk</h2><p class="text-secondary">We review every request, verify identity where necessary, and respond through the contact details you provide.</p><div class="bg-white border rounded-4 p-4 shadow-sm mt-4"><small class="text-uppercase fw-bold text-muted ls-1 d-block mb-2">Before you submit</small><ul class="text-secondary mb-0 ps-3"><li class="mb-2">Use an email address that our team can reach.</li><li class="mb-2">Describe the records or system involved.</li><li>Do not include passwords, payment details, or unnecessary sensitive data.</li></ul></div><div class="bg-white border rounded-4 p-4 shadow-sm mt-4"><small class="text-uppercase fw-bold text-muted ls-1 d-block mb-2">Response target</small><p class="text-secondary mb-0">Requests are triaged by our compliance team and handled in accordance with applicable privacy obligations.</p></div></div><div class="col-lg-7"><% if (status) { %><div class="alert <%= status === 'success' ? 'alert-success' : 'alert-danger' %> border-0 rounded-4" role="status"><strong><%= status === 'success' ? 'Request received.' : 'Request could not be submitted.' %></strong> <%= status === 'success' ? "Our compliance team will review the details and contact you." : "" %><% if (status !== 'success' && errorMsg === 'verification') { %>Security verification did not pass &mdash; please disable ad-blockers, complete the page fully, and try again.<% } else if (status !== 'success') { %>Please check all required fields: Name, Email, a valid Request Type, and Details (min. 10 chars), and confirm the agreement checkbox.<% } %></div><% } %><div class="bg-white border rounded-4 p-4 p-md-5 shadow-sm"><form action="/data-requests" method="post" data-recaptcha-action="dsr" id="dsr-form"><input type="hidden" name="csrf_token" value="<%= csrfToken %>"><input type="hidden" name="recaptcha_token" value=""><input class="bot-trap" type="text" name="bot_trap" tabindex="-1" autocomplete="off" aria-hidden="true"><div class="row g-4"><div class="col-md-6"><label class="form-label small fw-bold text-muted text-uppercase" for="requester-name">Full name</label><input class="form-control py-3" id="requester-name"  name="requester_name" maxlength="255" autocomplete="name" required value="<%= typeof formValues !== "undefined" && formValues.requesterName ? String(formValues.requesterName).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;') : "" %>"></div><div class="col-md-6"><label class="form-label small fw-bold text-muted text-uppercase" for="requester-email">Email address</label><input class="form-control py-3" id="requester-email"  name="requester_email" type="email" maxlength="320" autocomplete="email" required value="<%= typeof formValues !== "undefined" && formValues.requesterEmail ? String(formValues.requesterEmail).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;') : "" %>"></div><div class="col-12"><label class="form-label small fw-bold text-muted text-uppercase" for="request-type">Request type</label><select class="form-select py-3" id="request-type" name="request_type" required>
  <option value="" disabled <%= (typeof formValues === "undefined" || !formValues.requestType) ? "selected" : "" %>>Select a request type</option>
  <option value="Access" <%= typeof formValues !== "undefined" && formValues.requestType === "Access" ? "selected" : "" %>>Access</option>
  <option value="Modification" <%= typeof formValues !== "undefined" && formValues.requestType === "Modification" ? "selected" : "" %>>Modification</option>
  <option value="Deletion" <%= typeof formValues !== "undefined" && formValues.requestType === "Deletion" ? "selected" : "" %>>Deletion</option>
  <option value="Portability" <%= typeof formValues !== "undefined" && formValues.requestType === "Portability" ? "selected" : "" %>>Portability</option>
  <option value="Objection" <%= typeof formValues !== "undefined" && formValues.requestType === "Objection" ? "selected" : "" %>>Objection</option>
  <option value="Other" <%= typeof formValues !== "undefined" && formValues.requestType === "Other" ? "selected" : "" %>>Other</option>
</select></div><div class="col-12"><label class="form-label small fw-bold text-muted text-uppercase" for="specific-details">Request details</label><textarea class="form-control py-3" id="specific-details"  name="specific_details" rows="7" maxlength="10000" placeholder="Tell us what you would like us to review and any relevant account, inquiry, or project context." required><%= typeof formValues !== "undefined" && formValues.specificDetails ? String(formValues.specificDetails).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;') : "" %></textarea></div><div class="col-12"><div class="form-check"><input class="form-check-input" id="dsrConsent" name="legal_consent" value="on" type="checkbox" required><label class="form-check-label small text-secondary" for="dsrConsent">I confirm that the information above is accurate and agree to the <a href="/privacy">Privacy &amp; Data Policy</a>.</label></div></div><div class="col-12"><button class="btn btn-dark btn-lg w-100 rounded-pill fw-bold" type="submit">Submit data request <i class="fa-solid fa-shield-halved ms-2" aria-hidden="true"></i></button></div></div></form></div></div></div></div></section>
<%- include('../layouts/footer', { settings, footerMenus, waLink }) %>
