<%- include('../layouts/header', { pageTitle, pageDescription, pageKeywords, canonicalUrl, pageImage, settings, currentPage, socialLinks, schemaPhone }) %>

<link rel="stylesheet" href="/assets/css/premium.css">

<!-- Premium Hero -->
<section class="home-hero-mnc" style="min-height: 55vh; padding-top: 140px; padding-bottom: 60px;">
  <div class="hero-grid-premium" aria-hidden="true"></div>
  <div class="container position-relative">
    <div class="row align-items-center">
      <div class="col-lg-8">
        <span class="hero-tagline" data-aos="fade-up">Brand System & Media Kit</span>
        <h1 class="hero-title-mnc" data-aos="fade-up" data-aos-delay="100">
          Make CloudAlls <span>recognizable.</span>
        </h1>
        <p class="hero-lead-mnc" data-aos="fade-up" data-aos-delay="200">
          Built Wide. Built Deep. Use the CloudAlls identity to communicate a connected ecosystem of twelve strategic entities.
        </p>
        <div class="d-flex flex-wrap gap-3" data-aos="fade-up" data-aos-delay="300">
          <a class="btn btn-primary btn-lg rounded-pill px-5 py-3 fw-bold" style="font-size: 1rem;" href="#download">Download Assets</a>
          <a class="btn btn-outline-light btn-lg rounded-pill px-5 py-3 fw-bold" style="font-size: 1rem;" href="/contact">Media Enquiry</a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Official Assets Section -->
<section class="ecosystem-section bg-white" id="download">
  <div class="container">
    <div class="row mb-5">
      <div class="col-lg-8">
        <span class="section-kicker">Official Downloads</span>
        <h2 class="h2 fw-bold ls-tight" style="color: var(--mnc-navy);">One identity, ready for every surface.</h2>
      </div>
    </div>

    <div class="row g-4">
      <!-- Light Wordmark -->
      <div class="col-lg-6" data-aos="fade-up">
        <div class="ecosystem-card p-0 overflow-hidden h-100">
          <div class="bg-light d-flex align-items-center justify-content-center p-5" style="height: 200px;">
            <img src="/assets/brand/cloudalls_light.svg" alt="CloudAlls light wordmark" class="img-fluid" style="max-height: 60px;">
          </div>
          <div class="p-4">
            <h3 class="h5 fw-bold text-dark mb-2">Primary Wordmark (Light)</h3>
            <p class="text-secondary small mb-4">Optimized for light backgrounds, documents, and general web use.</p>
            <a href="/assets/brand/cloudalls_light.svg" download class="btn btn-outline-primary btn-sm rounded-pill fw-bold px-4">Download SVG</a>
          </div>
        </div>
      </div>
      <!-- Dark Wordmark -->
      <div class="col-lg-6" data-aos="fade-up" data-aos-delay="100">
        <div class="ecosystem-card p-0 overflow-hidden h-100">
          <div class="bg-dark d-flex align-items-center justify-content-center p-5" style="height: 200px;">
            <img src="/assets/brand/cloudalls_dark.svg" alt="CloudAlls dark wordmark" class="img-fluid" style="max-height: 60px;">
          </div>
          <div class="p-4">
            <h3 class="h5 fw-bold text-dark mb-2">Dark Wordmark</h3>
            <p class="text-secondary small mb-4">Designed for high-contrast dark surfaces and video overlays.</p>
            <a href="/assets/brand/cloudalls_dark.svg" download class="btn btn-outline-primary btn-sm rounded-pill fw-bold px-4">Download SVG</a>
          </div>
        </div>
      </div>
      <!-- Official Icon -->
      <div class="col-lg-4" data-aos="fade-up" data-aos-delay="200">
        <div class="ecosystem-card text-center h-100">
          <div class="ecosystem-icon mx-auto mb-4" style="width: 80px; height: 80px;">
            <img src="/assets/brand/icon-512x512.png" alt="CloudAlls Icon" class="img-fluid">
          </div>
          <h3 class="h6 fw-bold text-dark mb-2">Official Icon</h3>
          <p class="text-secondary small mb-4">The core circular mark used across PWAs and social profiles.</p>
          <a href="/assets/brand/icon-512x512.png" download class="btn btn-outline-primary btn-sm rounded-pill fw-bold px-4">Download 512px</a>
        </div>
      </div>
      <!-- Favicon -->
      <div class="col-lg-4" data-aos="fade-up" data-aos-delay="300">
        <div class="ecosystem-card text-center h-100">
          <div class="ecosystem-icon mx-auto mb-4" style="width: 80px; height: 80px;">
            <img src="/assets/brand/favicon.png" alt="CloudAlls Favicon" class="img-fluid">
          </div>
          <h3 class="h6 fw-bold text-dark mb-2">Browser Favicon</h3>
          <p class="text-secondary small mb-4">Transparent background optimized for browser tab visibility.</p>
          <a href="/assets/brand/favicon.png" download class="btn btn-outline-primary btn-sm rounded-pill fw-bold px-4">Download PNG</a>
        </div>
      </div>
      <!-- 192 Icon -->
      <div class="col-lg-4" data-aos="fade-up" data-aos-delay="400">
        <div class="ecosystem-card text-center h-100">
          <div class="ecosystem-icon mx-auto mb-4" style="width: 80px; height: 80px;">
            <img src="/assets/brand/icon-192x192.png" alt="CloudAlls 192 Icon" class="img-fluid">
          </div>
          <h3 class="h6 fw-bold text-dark mb-2">Web App Icon</h3>
          <p class="text-secondary small mb-4">Standard manifest icon for Android and iOS home screens.</p>
          <a href="/assets/brand/icon-192x192.png" download class="btn btn-outline-primary btn-sm rounded-pill fw-bold px-4">Download 192px</a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- The Ecosystem Section -->
<section class="home-final-cta py-5" style="background: var(--mnc-navy);">
  <div class="container py-lg-5">
    <div class="row mb-5 text-center">
      <div class="col-12">
        <span class="section-kicker text-info">The Ecosystem</span>
        <h2 class="h2 fw-bold text-white">Twelve entities. One connected standard.</h2>
      </div>
    </div>

    <% 
      const divisions = Array.isArray(settings.brand_divisions) ? settings.brand_divisions : [];
      const capDivs = divisions.filter(d => String(d.wing || 'capabilities') === 'capabilities');
      const vertDivs = divisions.filter(d => String(d.wing || '') === 'verticals');
    %>

    <div class="row g-4">
      <div class="col-12"><h3 class="h5 fw-bold text-info mb-4 text-uppercase ls-1">Wing A: Capability Divisions</h3></div>
      <% capDivs.forEach((division, index) => { %>
        <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="<%= index * 50 %>">
          <div class="p-4 rounded-4 bg-white bg-opacity-5 border border-white border-opacity-10 h-100">
            <img src="/assets/brand/icon-512x512.png" alt="Icon" style="width: 24px; opacity: 0.5;" class="mb-3">
            <h4 class="h6 fw-bold text-white mb-2"><%= division.name %></h4>
            <p class="text-white opacity-50 small mb-0" style="line-height: 1.5;"><%= division.tagline %></p>
          </div>
        </div>
      <% }); %>

      <div class="col-12 mt-5"><h3 class="h5 fw-bold text-info mb-4 text-uppercase ls-1">Wing B: Industry Verticals</h3></div>
      <% vertDivs.forEach((division, index) => { %>
        <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="<%= index * 50 %>">
          <div class="p-4 rounded-4 bg-white bg-opacity-5 border border-white border-opacity-10 h-100">
            <img src="/assets/brand/icon-512x512.png" alt="Icon" style="width: 24px; opacity: 0.5;" class="mb-3">
            <h4 class="h6 fw-bold text-white mb-2"><%= division.name %></h4>
            <p class="text-white opacity-50 small mb-0" style="line-height: 1.5;"><%= division.tagline %></p>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<%- include('../layouts/footer', { settings, footerMenus, waLink }) %>
