<section class="container-fluid bg-dark text-white py-5" style="background:radial-gradient(circle at 80% 20%,rgba(37,99,235,.35),transparent 38%),#0f172a;"><div class="container py-5"><p class="text-uppercase fw-bold text-info small ls-1 mb-3">Brand system</p><h1 class="display-3 fw-black ls-tight mb-4">A connected ecosystem of distinct capabilities.</h1><p class="lead text-white-50 mb-0" style="max-width:760px;">The CloudAlls divisions bring software, intelligence, infrastructure, creative systems, growth, operations, learning, and research into one coherent operating model.</p></div></section>
<section class="container py-5"><div class="row g-4"><% divisions.forEach((division, index) => { %><article class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="<%= index * 45 %>"><div class="h-100 p-4 rounded-4 border bg-white shadow-sm"><span class="text-primary fw-bold small"><%= String(index + 1).padStart(2, '0') %></span><h2 class="h4 fw-bold mt-3 mb-2"><%= division.name %></h2><p class="text-secondary mb-0"><%= division.tagline %></p></div></article><% }); %></div><div class="mt-5 p-5 rounded-4 bg-light border text-center"><h2 class="h3 fw-bold">Need the whole system?</h2><p class="text-secondary mb-4">Start with one clear conversation and let the right CloudAlls capabilities connect around it.</p><a class="btn btn-primary btn-lg rounded-pill px-4" href="/contact">Start a conversation</a></div></section>
<%- include('../layouts/footer', { settings, footerMenus, waLink }) %>
